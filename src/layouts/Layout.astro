---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cyrus · 数字大本营",
  description = "探索系统底层、AI 智能体与技术美学的交汇处。Cyrus 的个人独立站点与思考沉淀。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Persistent theme init (Default: Dark Observatory)
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }

      // Owner Mode state check
      const isOwner = localStorage.getItem('cyrus_owner_mode') === 'true';
      const hasToken = Boolean(localStorage.getItem('cyrus_github_pat'));
      const isVisitorPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';
      if (isOwner && hasToken && !isVisitorPreview) {
        document.documentElement.setAttribute('data-owner-mode', 'true');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-avatar">C</span>
          <span class="brand-name">Cyrus</span>
          <span class="brand-badge">OBS · 2026</span>
        </a>
        
        <nav class="nav">
          <a href="/" class="nav-link">深空视窗</a>
          <a href="/posts" class="nav-link">航行日志</a>
          <a href="/projects" class="nav-link">轨道造物</a>
          <a href="/gallery" class="nav-link">深空光影</a>
          <a href="/now" class="nav-link now-nav-link">
            <span class="pulse-dot"></span>信标
          </a>
          <a href="/about" class="nav-link">关于</a>
          <a href="https://github.com/Cyrus060224" target="_blank" rel="noreferrer" class="nav-link github-nav">GitHub</a>
          
          <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
            <span class="icon-sun">☼</span>
            <span class="icon-moon">☽</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-meta">
          <p class="mono-eyebrow">© 2026 CYRUS · DEEP SPACE OBSERVATORY · ORBIT: CF-EDGE</p>
          <p class="footer-desc">遥测状态：所有系统运转正常 · 坐标时区 UTC+8 · 保持克制与深空凝视</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Cyrus060224/Cyrus-s-IP" target="_blank" rel="noreferrer">Git-as-CMS</a>
          <span>·</span>
          <a href="/now">信标</a>
          <span>·</span>
          <a href="/admin" class="footer-admin-link">指令终端</a>
        </div>
      </div>
    </footer>

    <!-- Floating Owner Control Widget (Only active if device has token) -->
    <div id="owner-floating-widget" class="owner-widget" style="display: none;">
      <button id="owner-pill-btn" class="owner-pill" aria-label="站长模式控制">
        <span class="owner-dot"></span>
        <span id="owner-pill-label">站长模式</span>
      </button>

      <div id="owner-popover" class="owner-popover" style="display: none;">
        <div class="popover-header">
          <span class="popover-title">⚡ 站长控制台 (Cyrus)</span>
          <button id="popover-close-btn" class="popover-close">&times;</button>
        </div>
        <div class="popover-status">
          <span class="popover-status-dot"></span>
          <span id="popover-status-text">已连接到 GitHub 仓库</span>
        </div>
        <div class="popover-actions">
          <a href="/posts/?action=new" class="popover-btn popover-highlight">
            <span>✍️</span> 撰写新文章
          </a>
          <a href="/gallery/?action=upload" class="popover-btn popover-highlight">
            <span>📸</span> 上传相片 / 视频
          </a>
          <a href="/projects/?action=new" class="popover-btn popover-highlight">
            <span>🚀</span> 登记新造物
          </a>
          <div class="popover-divider"></div>
          <button id="toggle-preview-btn" class="popover-btn">
            👁️ <span id="toggle-preview-text">切换为访客视角</span>
          </button>
          <a href="/admin/" class="popover-btn">
            ⚙️ 站长管理中心
          </a>
          <button id="quick-logout-btn" class="popover-btn danger">
            ✕ 退出站长模式
          </button>
        </div>
      </div>
    </div>

    <!-- Theme and Owner Widget scripts -->
    <script is:inline>
      // 1. Theme toggle
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      // 2. Owner Floating Widget Logic
      function initOwnerWidget() {
        const token = localStorage.getItem('cyrus_github_pat');
        const isOwner = localStorage.getItem('cyrus_owner_mode') === 'true';
        const isVisitorPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';

        const widget = document.getElementById('owner-floating-widget');
        const pillBtn = document.getElementById('owner-pill-btn');
        const pillLabel = document.getElementById('owner-pill-label');
        const popover = document.getElementById('owner-popover');
        const closeBtn = document.getElementById('popover-close-btn');
        const togglePreviewBtn = document.getElementById('toggle-preview-btn');
        const togglePreviewText = document.getElementById('toggle-preview-text');
        const quickLogoutBtn = document.getElementById('quick-logout-btn');

        if (!token || !isOwner) {
          if (widget) widget.style.display = 'none';
          return;
        }

        // Show widget
        if (widget) widget.style.display = 'block';

        if (isVisitorPreview) {
          if (pillLabel) pillLabel.textContent = '访客预览中';
          if (pillBtn) pillBtn.classList.add('in-preview');
          if (togglePreviewText) togglePreviewText.textContent = '恢复站长视角';
        } else {
          if (pillLabel) pillLabel.textContent = '站长模式';
          if (pillBtn) pillBtn.classList.remove('in-preview');
          if (togglePreviewText) togglePreviewText.textContent = '切换为访客视角';
          document.documentElement.setAttribute('data-owner-mode', 'true');
          document.querySelectorAll('.owner-only').forEach(el => {
            el.style.setProperty('display', 'inline-flex', 'important');
          });
        }

        pillBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (popover) {
            popover.style.display = popover.style.display === 'none' ? 'block' : 'none';
          }
        });

        closeBtn?.addEventListener('click', () => {
          if (popover) popover.style.display = 'none';
        });

        document.addEventListener('click', (e) => {
          if (popover && !popover.contains(e.target) && e.target !== pillBtn) {
            popover.style.display = 'none';
          }
        });

        togglePreviewBtn?.addEventListener('click', () => {
          const currentlyPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';
          if (currentlyPreview) {
            localStorage.removeItem('cyrus_visitor_preview');
            document.documentElement.setAttribute('data-owner-mode', 'true');
          } else {
            localStorage.setItem('cyrus_visitor_preview', 'true');
            document.documentElement.removeAttribute('data-owner-mode');
          }
          window.location.reload();
        });

        quickLogoutBtn?.addEventListener('click', () => {
          if (confirm('确定要在当前设备上清除站长 Token 并退出吗？')) {
            localStorage.removeItem('cyrus_github_pat');
            localStorage.removeItem('cyrus_owner_mode');
            localStorage.removeItem('cyrus_visitor_preview');
            document.documentElement.removeAttribute('data-owner-mode');
            window.location.reload();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOwnerWidget);
      } else {
        initOwnerWidget();
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    padding: 1.15rem 0;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(11, 13, 16, 0.85);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background var(--duration-base) var(--ease-obs), border-color var(--duration-base) var(--ease-obs);
  }

  :global([data-theme="light"]) .site-header {
    background: rgba(244, 241, 234, 0.88);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-avatar {
    width: 28px;
    height: 28px;
    background: var(--paper-2);
    color: var(--accent);
    border: 1px solid var(--accent);
    box-shadow: 0 0 6px var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .brand-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--accent-tint);
    color: var(--accent);
    border: 1px solid rgba(235, 108, 54, 0.25);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav-link {
    transition: color 0.15s ease;
  }

  .now-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .nav-link:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 4px;
      gap: 1rem;
      font-size: 0.85rem;
    }
    .github-nav {
      display: none;
    }
  }

  .theme-btn {
    border: 1px solid var(--rule);
    background: var(--card-bg);
    color: var(--muted);
    border-radius: 20px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .theme-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .icon-moon { display: none; }
  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: inline; }

  .main-content {
    padding: 3rem 0 5rem;
  }

  .main-content:has(.observatory-hero-wrapper) {
    padding-top: 0;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 3rem 0;
    color: var(--soft);
    font-size: 0.85rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-desc {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-admin-link {
    color: var(--soft);
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }
  .footer-admin-link:hover {
    opacity: 1;
  }

  /* Global Owner-Only Visibility */
  :global(.owner-only) {
    display: none !important;
  }
  :global([data-owner-mode="true"] .owner-only) {
    display: inline-flex !important;
  }

  :global(.owner-only-flex) {
    display: none !important;
  }
  :global([data-owner-mode="true"] .owner-only-flex) {
    display: flex !important;
  }

  /* Floating Owner Mode Widget */
  .owner-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 999;
  }

  .owner-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    padding: 6px 12px;
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
  }

  .owner-pill:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  .owner-pill.in-preview {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .owner-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .owner-pill.in-preview .owner-dot {
    background: #f59e0b;
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.6);
  }

  .owner-popover {
    position: absolute;
    bottom: 2.5rem;
    right: 0;
    width: 260px;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    margin-bottom: 0.5rem;
  }

  .popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .popover-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .popover-close {
    background: none;
    border: none;
    font-size: 1.2rem;
    color: var(--soft);
    cursor: pointer;
    line-height: 1;
  }

  .popover-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .popover-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .popover-actions {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .popover-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
  }

  .popover-btn:hover {
    background: var(--paper-2);
    border-color: var(--ink);
  }

  .popover-btn.danger {
    color: #ef4444;
  }
  .popover-btn.danger:hover {
    background: rgba(239, 68, 68, 0.08);
    border-color: #ef4444;
  }

  .popover-highlight {
    background: var(--accent-tint);
    border-color: rgba(235, 108, 54, 0.3);
    color: var(--accent);
    font-weight: 600;
  }
  .popover-highlight:hover {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .popover-divider {
    height: 1px;
    background: var(--rule);
    margin: 4px 0;
  }
</style>
