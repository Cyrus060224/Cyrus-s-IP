---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cyrus · 数字大本营",
  description = "探索系统底层、AI 智能体与技术美学的交汇处。Cyrus 的个人独立站点与思考沉淀。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark" data-theme-pref="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070B" id="meta-theme-color" />
    <ClientRouter />
    <script is:inline>
      // Persistent tri-state theme init (Default: Dark Observatory, supports System / Light / Dark)
      (function() {
        const urlTheme = new URLSearchParams(window.location.search).get('theme');
        const storedPref = localStorage.getItem('theme');
        // First visit defaults to 'dark' for Deep Space Observatory aesthetic
        const pref = urlTheme || storedPref || 'dark';

        const isSystemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        let effectiveTheme = 'dark';
        if (pref === 'light') {
          effectiveTheme = 'light';
        } else if (pref === 'dark') {
          effectiveTheme = 'dark';
        } else if (pref === 'system') {
          effectiveTheme = isSystemDark ? 'dark' : 'light';
        }

        document.documentElement.setAttribute('data-theme', effectiveTheme);
        document.documentElement.setAttribute('data-theme-pref', pref);
        document.documentElement.style.colorScheme = effectiveTheme;

        const metaThemeColor = document.getElementById('meta-theme-color');
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', effectiveTheme === 'light' ? '#F2F5F9' : '#05070B');
        }

        // Owner Mode state check
        const isOwner = localStorage.getItem('cyrus_owner_mode') === 'true';
        const hasToken = Boolean(localStorage.getItem('cyrus_github_pat'));
        const isVisitorPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';
        if (isOwner && hasToken && !isVisitorPreview) {
          document.documentElement.setAttribute('data-owner-mode', 'true');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-avatar">C</span>
          <span class="brand-name">Cyrus</span>
          <span class="brand-badge">OBS · 2026</span>
        </a>
        
        <nav class="nav">
          <a href="/" class="nav-link">深空视窗</a>
          <a href="/posts" class="nav-link">航行日志</a>
          <a href="/projects" class="nav-link">轨道造物</a>
          <a href="/gallery" class="nav-link">深空光影</a>
          <a href="/now" class="nav-link now-nav-link">
            <span class="pulse-dot"></span>信标
          </a>
          <a href="/about" class="nav-link">关于</a>
          <a href="https://github.com/Cyrus060224" target="_blank" rel="noreferrer" class="nav-link github-nav">GitHub</a>
          
          <button 
            id="theme-toggle" 
            type="button" 
            class="theme-btn" 
            aria-label="当前主题：暗色模式（点击切换为浅色模式）"
            title="切换主题（深空暗色 / 日照浅色 / 跟随系统）"
            transition:persist
          >
            <span class="icon-moon" title="暗色模式" aria-hidden="true">☽</span>
            <span class="icon-sun" title="浅色模式" aria-hidden="true">☼</span>
            <span class="icon-system" title="跟随系统" aria-hidden="true">◐</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-meta">
          <p class="mono-eyebrow">© 2026 CYRUS · DEEP SPACE OBSERVATORY · ORBIT: CF-EDGE</p>
          <p class="footer-desc">遥测状态：所有系统运转正常 · 坐标时区 UTC+8 · 保持克制与深空凝视</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Cyrus060224/Cyrus-s-IP" target="_blank" rel="noreferrer">Git-as-CMS</a>
          <span>·</span>
          <a href="/now">信标</a>
          <span>·</span>
          <a href="/admin" class="footer-admin-link">指令终端</a>
        </div>
      </div>
    </footer>

    <!-- Floating Owner Control Widget (Only active if device has token) -->
    <div id="owner-floating-widget" class="owner-widget" style="display: none;">
      <button id="owner-pill-btn" class="owner-pill" aria-label="站长模式控制">
        <span class="owner-dot"></span>
        <span id="owner-pill-label">站长模式</span>
      </button>

      <div id="owner-popover" class="owner-popover" style="display: none;">
        <div class="popover-header">
          <span class="popover-title">⚡ 站长控制台 (Cyrus)</span>
          <button id="popover-close-btn" class="popover-close">&times;</button>
        </div>
        <div class="popover-status">
          <span class="popover-status-dot"></span>
          <span id="popover-status-text">已连接到 GitHub 仓库</span>
        </div>
        <div class="popover-actions">
          <a href="/posts/?action=new" class="popover-btn popover-highlight">
            <span>✍️</span> 撰写新文章
          </a>
          <a href="/gallery/?action=upload" class="popover-btn popover-highlight">
            <span>📸</span> 上传相片 / 视频
          </a>
          <a href="/projects/?action=new" class="popover-btn popover-highlight">
            <span>🚀</span> 登记新造物
          </a>
          <div class="popover-divider"></div>
          <button id="toggle-preview-btn" class="popover-btn">
            👁️ <span id="toggle-preview-text">切换为访客视角</span>
          </button>
          <a href="/admin/" class="popover-btn">
            ⚙️ 站长管理中心
          </a>
          <button id="quick-logout-btn" class="popover-btn danger">
            ✕ 退出站长模式
          </button>
        </div>
      </div>
    </div>

    <!-- Theme and Owner Widget scripts -->
    <script is:inline>
      // 1. Theme state manager
      function getEffectiveTheme(pref) {
        if (pref === 'light') return 'light';
        if (pref === 'dark') return 'dark';
        if (pref === 'system') {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        return 'dark';
      }

      function applyTheme(pref, persist) {
        if (persist) {
          localStorage.setItem('theme', pref);
        }
        const effective = getEffectiveTheme(pref);
        document.documentElement.setAttribute('data-theme', effective);
        document.documentElement.setAttribute('data-theme-pref', pref);
        document.documentElement.style.colorScheme = effective;

        const meta = document.getElementById('meta-theme-color') || document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', effective === 'light' ? '#F2F5F9' : '#05070B');
        }

        const toggle = document.getElementById('theme-toggle');
        if (toggle) {
          if (pref === 'dark') {
            toggle.setAttribute('aria-label', '当前主题：暗色模式（点击切换为浅色模式）');
            toggle.setAttribute('title', '当前主题：深空暗色（点击切换为日照浅色）');
          } else if (pref === 'light') {
            toggle.setAttribute('aria-label', '当前主题：浅色模式（点击切换为跟随系统）');
            toggle.setAttribute('title', '当前主题：日照浅色（点击切换为跟随系统）');
          } else {
            toggle.setAttribute('aria-label', '当前主题：跟随系统（点击切换为暗色模式）');
            toggle.setAttribute('title', '当前主题：跟随系统（点击切换为深空暗色）');
          }
        }
      }

      function handleThemeToggle(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        const currentPref = localStorage.getItem('theme') || document.documentElement.getAttribute('data-theme-pref') || 'dark';
        let nextPref = 'light';
        if (currentPref === 'dark') {
          nextPref = 'light';
        } else if (currentPref === 'light') {
          nextPref = 'system';
        } else {
          nextPref = 'dark';
        }
        applyTheme(nextPref, true);
      }

      function bindThemeButton() {
        const toggle = document.getElementById('theme-toggle');
        if (!toggle) return;
        toggle.removeEventListener('click', handleThemeToggle);
        toggle.addEventListener('click', handleThemeToggle);

        toggle.onkeydown = (e) => {
          if (e.key === 'Enter' || e.key === ' ' || e.keyCode === 13 || e.keyCode === 32) {
            handleThemeToggle(e);
          }
        };

        const currentPref = localStorage.getItem('theme') || document.documentElement.getAttribute('data-theme-pref') || 'dark';
        applyTheme(currentPref, false);
      }

      // Listen to OS appearance changes in real time
      if (window.matchMedia) {
        const mql = window.matchMedia('(prefers-color-scheme: dark)');
        mql.addEventListener('change', () => {
          const pref = localStorage.getItem('theme') || document.documentElement.getAttribute('data-theme-pref');
          if (pref === 'system') {
            applyTheme('system', false);
          }
        });
      }

      // Astro View Transitions lifecycle hooks
      document.addEventListener('astro:after-swap', () => {
        const pref = localStorage.getItem('theme') || document.documentElement.getAttribute('data-theme-pref') || 'dark';
        applyTheme(pref, false);
      });

      document.addEventListener('astro:page-load', () => {
        bindThemeButton();
        initOwnerWidget();
      });

      // Direct load execution
      bindThemeButton();

      // 2. Owner Floating Widget Logic
      function initOwnerWidget() {
        const token = localStorage.getItem('cyrus_github_pat');
        const isOwner = localStorage.getItem('cyrus_owner_mode') === 'true';
        const isVisitorPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';

        const widget = document.getElementById('owner-floating-widget');
        const pillBtn = document.getElementById('owner-pill-btn');
        const pillLabel = document.getElementById('owner-pill-label');
        const popover = document.getElementById('owner-popover');
        const closeBtn = document.getElementById('popover-close-btn');
        const togglePreviewBtn = document.getElementById('toggle-preview-btn');
        const togglePreviewText = document.getElementById('toggle-preview-text');
        const quickLogoutBtn = document.getElementById('quick-logout-btn');

        if (!token || !isOwner) {
          if (widget) widget.style.display = 'none';
          return;
        }

        // Show widget
        if (widget) widget.style.display = 'block';

        if (isVisitorPreview) {
          if (pillLabel) pillLabel.textContent = '访客预览中';
          if (pillBtn) pillBtn.classList.add('in-preview');
          if (togglePreviewText) togglePreviewText.textContent = '恢复站长视角';
        } else {
          if (pillLabel) pillLabel.textContent = '站长模式';
          if (pillBtn) pillBtn.classList.remove('in-preview');
          if (togglePreviewText) togglePreviewText.textContent = '切换为访客视角';
          document.documentElement.setAttribute('data-owner-mode', 'true');
          document.querySelectorAll('.owner-only').forEach(el => {
            el.style.setProperty('display', 'inline-flex', 'important');
          });
        }

        pillBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (popover) {
            popover.style.display = popover.style.display === 'none' ? 'block' : 'none';
          }
        });

        closeBtn?.addEventListener('click', () => {
          if (popover) popover.style.display = 'none';
        });

        document.addEventListener('click', (e) => {
          if (popover && !popover.contains(e.target) && e.target !== pillBtn) {
            popover.style.display = 'none';
          }
        });

        togglePreviewBtn?.addEventListener('click', () => {
          const currentlyPreview = localStorage.getItem('cyrus_visitor_preview') === 'true';
          if (currentlyPreview) {
            localStorage.removeItem('cyrus_visitor_preview');
            document.documentElement.setAttribute('data-owner-mode', 'true');
          } else {
            localStorage.setItem('cyrus_visitor_preview', 'true');
            document.documentElement.removeAttribute('data-owner-mode');
          }
          window.location.reload();
        });

        quickLogoutBtn?.addEventListener('click', () => {
          if (confirm('确定要在当前设备上清除站长 Token 并退出吗？')) {
            localStorage.removeItem('cyrus_github_pat');
            localStorage.removeItem('cyrus_owner_mode');
            localStorage.removeItem('cyrus_visitor_preview');
            document.documentElement.removeAttribute('data-owner-mode');
            window.location.reload();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOwnerWidget);
      } else {
        initOwnerWidget();
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    padding: 1.15rem 0;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(5, 7, 11, 0.85);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background var(--duration-base) var(--ease-obs), border-color var(--duration-base) var(--ease-obs);
  }

  :global([data-theme="light"]) .site-header {
    background: rgba(242, 245, 249, 0.88);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-avatar {
    width: 28px;
    height: 28px;
    background: var(--paper-2);
    color: var(--accent);
    border: 1px solid var(--accent);
    box-shadow: 0 0 6px var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .brand-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--accent-tint);
    color: var(--accent);
    border: 1px solid var(--accent-glow);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav-link {
    transition: color 0.15s ease;
  }

  .now-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-online);
    box-shadow: 0 0 0 0 var(--status-online-tint);
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 var(--status-online-tint); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .nav-link:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 4px;
      gap: 1rem;
      font-size: 0.85rem;
    }
    .github-nav {
      display: none;
    }
  }

  .theme-btn {
    border: 1px solid var(--rule);
    background: var(--card-bg);
    color: var(--muted);
    border-radius: 20px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    user-select: none;
    transition: all 0.15s ease;
  }

  .theme-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .theme-btn .icon-moon,
  .theme-btn .icon-sun,
  .theme-btn .icon-system {
    display: none;
  }

  :global([data-theme-pref="dark"]) .theme-btn .icon-moon {
    display: inline-flex;
  }
  :global([data-theme-pref="light"]) .theme-btn .icon-sun {
    display: inline-flex;
  }
  :global([data-theme-pref="system"]) .theme-btn .icon-system {
    display: inline-flex;
  }

  .main-content {
    padding: 3rem 0 5rem;
  }

  .main-content:has(.observatory-hero-wrapper) {
    padding-top: 0;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 3rem 0;
    color: var(--soft);
    font-size: 0.85rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-desc {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-admin-link {
    color: var(--soft);
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }
  .footer-admin-link:hover {
    opacity: 1;
  }

  /* Global Owner-Only Visibility */
  :global(.owner-only) {
    display: none !important;
  }
  :global([data-owner-mode="true"] .owner-only) {
    display: inline-flex !important;
  }

  :global(.owner-only-flex) {
    display: none !important;
  }
  :global([data-owner-mode="true"] .owner-only-flex) {
    display: flex !important;
  }

  /* Floating Owner Mode Widget */
  .owner-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 999;
  }

  .owner-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    padding: 6px 12px;
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
  }

  .owner-pill:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  .owner-pill.in-preview {
    border-color: var(--status-preview);
    color: var(--status-preview);
  }

  .owner-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-online);
    box-shadow: 0 0 6px var(--status-online-tint);
  }

  .owner-pill.in-preview .owner-dot {
    background: var(--status-preview);
    box-shadow: 0 0 6px var(--status-preview-tint);
  }

  .owner-popover {
    position: absolute;
    bottom: 2.5rem;
    right: 0;
    width: 260px;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    margin-bottom: 0.5rem;
  }

  .popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .popover-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .popover-close {
    background: none;
    border: none;
    font-size: 1.2rem;
    color: var(--soft);
    cursor: pointer;
    line-height: 1;
  }

  .popover-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .popover-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-online);
  }

  .popover-actions {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .popover-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
  }

  .popover-btn:hover {
    background: var(--paper-2);
    border-color: var(--ink);
  }

  .popover-btn.danger {
    color: var(--status-danger);
  }
  .popover-btn.danger:hover {
    background: var(--status-danger-tint);
    border-color: var(--status-danger);
  }

  .popover-highlight {
    background: var(--accent-tint);
    border-color: var(--accent-glow);
    color: var(--accent);
    font-weight: 600;
  }
  .popover-highlight:hover {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
  }

  .popover-divider {
    height: 1px;
    background: var(--rule);
    margin: 4px 0;
  }
</style>
