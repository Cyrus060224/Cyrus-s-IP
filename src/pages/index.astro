---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, getCategoryMeta } from '../utils/categories';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured post (or the newest one)
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
// Other posts
const otherPosts = sortedPosts.filter(p => p.id !== featuredPost?.id).slice(0, 4);
---

<Layout 
  title="Cyrus · 数字大本营"
  description="探索系统底层、AI 智能体与技术美学的交汇处。Cyrus 的个人独立站点与思考沉淀。"
>
  <div class="container home-container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="mono-eyebrow">DIGITAL GARDEN · BUILD IN PUBLIC</div>
      <h1 class="serif-title hero-title">
        在喧嚣与代码之中，<br/>
        构建属于自己的数字主权领地。
      </h1>
      <p class="hero-desc">
        你好，我是 <strong>Cyrus</strong>。我热衷于探索系统底层架构、自主 AI 智能体以及具有杂志级质感的技术表达。这里是我的数字大本营，记录我从 0 到 1 的每一次思考与工程实践。
      </p>

      <div class="hero-actions">
        <a href="/posts" class="btn btn-primary">文章档案 →</a>
        <a href="/projects" class="btn btn-secondary">造物工坊</a>
        <a href="/gallery" class="btn btn-secondary">光影画廊</a>
        <a href="/about" class="btn btn-ghost">关于我</a>
      </div>

      <!-- Quick Category Nav Pills -->
      <div class="hero-categories">
        <span class="cat-label">常设专栏：</span>
        <div class="cat-pill-list">
          {Object.values(CATEGORIES).map(cat => (
            <a href={`/posts?category=${cat.id}`} class="hero-cat-pill">
              <span class="pill-dot" style={`background: ${cat.badgeColor}`}></span>
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Post Section -->
    {featuredPost && (
      <section class="featured-section">
        <div class="section-header">
          <h2 class="section-title">置顶推荐 / Featured</h2>
          <span class="mono-eyebrow">EDITOR'S PICK</span>
        </div>

        {(() => {
          const cat = getCategoryMeta(featuredPost.data.category);
          const formattedDate = new Intl.DateTimeFormat('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(featuredPost.data.pubDate);

          return (
            <a href={`/posts/${featuredPost.id}`} class="featured-card">
              <div class="card-top">
                <span class="badge" style={`background: ${cat.badgeBg}; color: ${cat.badgeColor}`}>
                  {cat.name}
                </span>
                <span class="post-date">{formattedDate}</span>
              </div>

              <h3 class="card-title">{featuredPost.data.title}</h3>
              
              <p class="card-excerpt">{featuredPost.data.description}</p>

              {featuredPost.data.heroImage && (
                <div class="card-preview-thumb">
                  <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
                </div>
              )}

              <div class="card-footer">
                <div class="tags">
                  {featuredPost.data.tags?.map((t: string) => (
                    <span class="tag">#{t}</span>
                  ))}
                </div>
                <span class="read-more">阅读全文 →</span>
              </div>
            </a>
          );
        })()}
      </section>
    )}

    <!-- Recent Posts Stream -->
    {otherPosts.length > 0 && (
      <section class="recent-posts-section">
        <div class="section-header">
          <h2 class="section-title">最新记录 / Recent Posts</h2>
          <a href="/posts" class="view-all-link">查看全部文章 ({sortedPosts.length}) →</a>
        </div>

        <div class="recent-grid">
          {otherPosts.map(post => {
            const cat = getCategoryMeta(post.data.category);
            const formattedDate = new Intl.DateTimeFormat('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit'
            }).format(post.data.pubDate);

            return (
              <a href={`/posts/${post.id}`} class="recent-card">
                <div class="recent-meta">
                  <span class="recent-cat" style={`color: ${cat.badgeColor}`}>
                    {cat.name}
                  </span>
                  <time class="recent-date">{formattedDate}</time>
                </div>
                <h4 class="recent-title">{post.data.title}</h4>
                <p class="recent-excerpt">{post.data.description}</p>
                <div class="recent-tags">
                  {post.data.tags?.slice(0, 3).map((t: string) => (
                    <span class="mini-tag">#{t}</span>
                  ))}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Core Pillars / Philosophy -->
    <section class="pillars-section">
      <div class="section-header">
        <h2 class="section-title">创作基准 / Principles</h2>
        <span class="mono-eyebrow">CORE VALUES</span>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-num">01</div>
          <h3>数字主权</h3>
          <p>拒绝被平台算法与信息茧房绑架。独立博客是永不过期的思想自留地，为自己沉淀真正属于个人的长期数字资产。</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-num">02</div>
          <h3>克制审美</h3>
          <p>好的技术表达需要对等的视觉审美。摒弃浮夸的阴影与 AI 塑料感，坚持以 4/10 的克制密度呈现杂志级清晰结构。</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-num">03</div>
          <h3>多元共存</h3>
          <p>硬核的技术造物与细腻的旷野游记并不冲突。代码是理性的骨架，文字与摄影是感性的血肉，二者共同构成丰满的个人 IP。</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-container {
    padding-top: 1.5rem;
  }

  .hero-section {
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .hero-title {
    font-size: clamp(2.2rem, 4vw + 1.2rem, 3.4rem);
    margin: 1.2rem 0 1.5rem;
    color: var(--ink);
  }

  .hero-desc {
    max-width: 62ch;
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--ink);
  }
  .btn-secondary:hover {
    border-color: var(--ink);
  }

  .btn-ghost {
    color: var(--muted);
  }
  .btn-ghost:hover {
    color: var(--ink);
  }

  /* Quick Category Nav */
  .hero-categories {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--rule);
    font-size: 0.85rem;
  }

  .cat-label {
    font-family: var(--font-mono);
    color: var(--soft);
    font-size: 0.75rem;
  }

  .cat-pill-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.8rem;
    color: var(--muted);
    transition: all 0.15s ease;
  }

  .hero-cat-pill:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  /* Section Common */
  .featured-section, .recent-posts-section, .pillars-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 400;
    color: var(--ink);
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
  }

  /* Featured Post Card */
  .featured-card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .featured-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .post-date {
    color: var(--soft);
  }

  .card-title {
    font-size: 1.45rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--ink);
    line-height: 1.35;
  }

  .card-excerpt {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .card-preview-thumb {
    margin-bottom: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-2);
  }

  .card-preview-thumb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .read-more {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 500;
  }

  /* Recent Posts Grid */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .recent-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .recent-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .recent-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .recent-cat {
    font-weight: 600;
  }

  .recent-date {
    color: var(--soft);
  }

  .recent-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .recent-excerpt {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recent-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .pillar-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .pillar-card p {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .recent-grid { grid-template-columns: 1fr; }
    .pillars-grid { grid-template-columns: 1fr; }
  }
</style>
