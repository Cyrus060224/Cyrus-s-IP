---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ObservatoryHero from '../components/observatory/ObservatoryHero.astro';
import { CATEGORIES, getCategoryMeta } from '../utils/categories';

// Fetch all collections
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter(p => p.id !== featuredPost?.id).slice(0, 4);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
  const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
  return dateB - dateA;
}).slice(0, 4);

const allGallery = await getCollection('gallery');
const recentGallery = allGallery
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestPostDate = sortedPosts[0]?.data.pubDate
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(sortedPosts[0].data.pubDate).replace(/\//g, '.')
  : '2026.10.16';

const latestProjectDate = sortedProjects[0]?.data.pubDate
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(sortedProjects[0].data.pubDate).replace(/\//g, '.')
  : '2026.10.12';

const latestGalleryDate = recentGallery[0]?.data.date
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(recentGallery[0].data.date).replace(/\//g, '.')
  : '2026.10.11';

const projectCategoryMap: Record<string, { label: string; color: string }> = {
  ai: { label: 'AI & 智能体', color: '#2e5aa8' },
  web: { label: 'Web & 站点', color: '#eb6c36' },
  tool: { label: '实战工具', color: '#2a9d8f' },
  system: { label: '系统底层', color: '#805ad5' },
};

const statusMap: Record<string, { label: string; dotClass: string }> = {
  active: { label: '活跃维护', dotClass: 'status-active' },
  shipped: { label: '已发布', dotClass: 'status-shipped' },
  experiment: { label: '探索实验', dotClass: 'status-exp' },
};
---

<Layout 
  title="Cyrus · 深空观测站 · 独立主权个人站"
  description="探索系统底层、AI 智能体与技术美学的交汇处。Cyrus 的全方位个人深空观测站与深度沉淀。"
>
  <!-- 0. 3D Deep Space Planetary Orbit Entrance Island -->
  <ObservatoryHero 
    postsCount={allPosts.length}
    latestPostDate={latestPostDate}
    projectsCount={allProjects.length}
    latestProjectDate={latestProjectDate}
    galleryCount={allGallery.length}
    latestGalleryDate={latestGalleryDate}
  />

  <div class="container home-container">
    <!-- Quick Category Nav Bridge -->
    <section class="station-bridge-section">
      <div class="bridge-row">
        <span class="cat-label">常设专栏：</span>
        <div class="cat-pill-list">
          {Object.values(CATEGORIES).map(cat => (
            <a href={`/posts?category=${cat.id}`} class="hero-cat-pill">
              <span class="pill-dot" style={`background: ${cat.badgeColor}`}></span>
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. Featured Spotlight (置顶精选) -->
    {featuredPost && (
      <section class="featured-section">
        <div class="section-header">
          <div>
            <span class="mono-eyebrow">STATION SPOTLIGHT · 观测台焦点</span>
            <h2 class="section-title">重点航行日志 / Featured Log</h2>
          </div>
          <span class="header-badge">本期主标</span>
        </div>

        {(() => {
          const cat = getCategoryMeta(featuredPost.data.category);
          const formattedDate = new Intl.DateTimeFormat('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(featuredPost.data.pubDate);

          return (
            <a href={`/posts/${featuredPost.id}`} class="featured-card">
              <div class="card-top">
                <span class="telemetry-badge">LOG-{formattedDate.replace(/\//g, '.')}</span>
                <span class="badge" style={`background: ${cat.badgeBg}; color: ${cat.badgeColor}`}>
                  {cat.name}
                </span>
                <span class="post-date">{formattedDate}</span>
              </div>

              <h3 class="card-title">{featuredPost.data.title}</h3>
              <p class="card-excerpt">{featuredPost.data.description}</p>

              {featuredPost.data.heroImage && (
                <div class="card-preview-thumb">
                  <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="lazy" />
                </div>
              )}

              <div class="card-footer">
                <div class="tags">
                  {featuredPost.data.tags?.map((t: string) => (
                    <span class="tag">#{t}</span>
                  ))}
                </div>
                <span class="read-more">阅读日志全文 →</span>
              </div>
            </a>
          );
        })()}
      </section>
    )}

    <!-- 3. Recent Posts (最新思考与随笔) -->
    {recentPosts.length > 0 && (
      <section class="recent-posts-section">
        <div class="section-header">
          <div>
            <span class="mono-eyebrow">FLIGHT LOG ARCHIVES · 航行日志</span>
            <h2 class="section-title">最新思想记录 / Recent Logs</h2>
          </div>
          <a href="/posts" class="view-all-link">查看全部日志 ({allPosts.length}) →</a>
        </div>

        <div class="recent-grid">
          {recentPosts.map(post => {
            const cat = getCategoryMeta(post.data.category);
            const formattedDate = new Intl.DateTimeFormat('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit'
            }).format(post.data.pubDate);

            return (
              <a href={`/posts/${post.id}`} class="recent-card">
                <div class="recent-meta">
                  <span class="telemetry-badge">LOG-{formattedDate.replace(/\//g, '.')}</span>
                  <span class="recent-cat" style={`color: ${cat.badgeColor}`}>
                    {cat.name}
                  </span>
                  <time class="recent-date">{formattedDate}</time>
                </div>
                <h4 class="recent-title">{post.data.title}</h4>
                <p class="recent-excerpt">{post.data.description}</p>
                <div class="recent-tags">
                  {post.data.tags?.slice(0, 3).map((t: string) => (
                    <span class="mini-tag">#{t}</span>
                  ))}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- 4. Selected Crafts & Projects (造物工坊精选) -->
    {sortedProjects.length > 0 && (
      <section class="projects-section">
        <div class="section-header">
          <div>
            <span class="mono-eyebrow">ORBITAL INSTRUMENTS · 轨道造物</span>
            <h2 class="section-title">探测器与实验台 / Selected Crafts</h2>
          </div>
          <a href="/projects" class="view-all-link">全部造物 ({allProjects.length}) →</a>
        </div>

        <div class="projects-grid">
          {sortedProjects.map((proj, idx) => {
            const cat = projectCategoryMap[proj.data.category] || { label: proj.data.category, color: '#666' };
            const status = statusMap[proj.data.status] || { label: proj.data.status, dotClass: 'status-active' };

            return (
              <article class="proj-card">
                <div class="proj-card-top">
                  <span class="telemetry-badge">PRJ-00{idx + 1}</span>
                  <span class="proj-cat" style={`color: ${cat.color}; border-color: ${cat.color}33;`}>
                    {cat.label}
                  </span>
                  <div class="proj-status">
                    <span class={`status-dot ${status.dotClass}`}></span>
                    <span class="status-label">{status.label}</span>
                  </div>
                </div>

                <h3 class="proj-title">
                  <a href={`/projects/${proj.id}`}>{proj.data.title}</a>
                </h3>

                <p class="proj-desc">{proj.data.description}</p>

                <div class="proj-tags">
                  {proj.data.tags?.slice(0, 3).map((t: string) => (
                    <span class="mini-tag">#{t}</span>
                  ))}
                </div>

                <div class="proj-footer">
                  <div class="proj-links">
                    {proj.data.github && (
                      <a href={proj.data.github} target="_blank" rel="noreferrer" class="proj-action">GitHub ↗</a>
                    )}
                    {proj.data.demo && (
                      <a href={proj.data.demo} target="_blank" rel="noreferrer" class="proj-action accent-link">在线访问 ↗</a>
                    )}
                  </div>
                  <a href={`/projects/${proj.id}`} class="proj-detail">详情 →</a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 5. Visual Moments & Media (光影画廊速览) -->
    {recentGallery.length > 0 && (
      <section class="gallery-preview-section">
        <div class="section-header">
          <div>
            <span class="mono-eyebrow">OPTICAL OBSERVATION · 深空光影</span>
            <h2 class="section-title">深空视窗存档 / Visual Journal</h2>
          </div>
          <a href="/gallery" class="view-all-link">浏览完整视窗 ({allGallery.length}) →</a>
        </div>

        <div class="gallery-strip">
          {recentGallery.map((item, idx) => {
            const isVideo = item.data.type === 'video';
            const formattedDate = new Intl.DateTimeFormat('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit'
            }).format(item.data.date);

            return (
              <a href="/gallery" class="strip-item">
                <div class="strip-thumb-wrap">
                  {isVideo ? (
                    <video src={item.data.mediaUrl} muted loop playsinline class="strip-thumb"></video>
                  ) : (
                    <img src={item.data.mediaUrl} alt={item.data.title} loading="lazy" class="strip-thumb" />
                  )}
                  {isVideo && <span class="video-pill">▶ 动效记录</span>}
                </div>
                <div class="strip-info">
                  <div class="strip-meta">
                    <span class="telemetry-badge">OBS-00{idx + 1}</span>
                    <span class="strip-date">{formattedDate}</span>
                    {item.data.location && <span class="strip-loc">📍 {item.data.location}</span>}
                  </div>
                  <h4 class="strip-title">{item.data.title}</h4>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}



    <!-- 7. Core Pillars / Philosophy (创作基准) -->
    <section class="pillars-section">
      <div class="section-header">
        <div>
          <span class="mono-eyebrow">OBSERVATORY PROTOCOLS · 站长基准</span>
          <h2 class="section-title">观测原则 / Protocols</h2>
        </div>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-num">01</div>
          <h3>数字主权</h3>
          <p>拒绝被平台算法与信息茧房绑架。独立博客是永不过期的思想自留地，为自己沉淀真正属于个人的长期数字资产。</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-num">02</div>
          <h3>克制审美</h3>
          <p>好的技术表达需要对等的视觉审美。摒弃浮夸的渐变与 AI 塑料感，坚持以 4/10 的克制密度呈现杂志级清晰结构。</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-num">03</div>
          <h3>多元共存</h3>
          <p>硬核的技术造物与细腻的旷野游记并不冲突。代码是理性的骨架，文字与摄影是感性的血肉，二者共同构成丰满的个人 IP。</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-container {
    padding-top: 0.5rem;
  }

  .station-bridge-section {
    padding-bottom: 2.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .bridge-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--ink);
  }
  .btn-secondary:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }

  .btn-studio {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    color: var(--accent);
    font-weight: 600;
  }
  .btn-studio:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .btn-ghost {
    color: var(--muted);
  }
  .btn-ghost:hover {
    color: var(--ink);
  }

  /* Quick Category Nav */
  .hero-categories {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--rule);
    font-size: 0.85rem;
  }

  .cat-label {
    font-family: var(--font-mono);
    color: var(--soft);
    font-size: 0.75rem;
  }

  .cat-pill-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.8rem;
    color: var(--muted);
    transition: all 0.15s ease;
  }

  .hero-cat-pill:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  /* Section Common */
  .featured-section, 
  .recent-posts-section, 
  .projects-section, 
  .gallery-preview-section,
  .studio-banner-section,
  .pillars-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 400;
    color: var(--ink);
    margin-top: 0.35rem;
  }

  .header-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--accent-tint);
    color: var(--accent);
    border: 1px solid rgba(235, 108, 54, 0.2);
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    transition: opacity 0.15s ease;
  }
  .view-all-link:hover {
    opacity: 0.8;
  }

  /* Featured Post Card */
  .featured-card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .featured-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .post-date {
    color: var(--soft);
  }

  .card-title {
    font-size: 1.55rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--ink);
    line-height: 1.35;
  }

  .card-excerpt {
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .card-preview-thumb {
    margin-bottom: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-2);
    max-height: 340px;
  }

  .card-preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .read-more {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 500;
  }

  /* Recent Posts Grid */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .recent-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .recent-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .recent-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .recent-cat {
    font-weight: 600;
  }

  .recent-date {
    color: var(--soft);
  }

  .recent-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .recent-excerpt {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recent-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .proj-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .proj-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .proj-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .proj-cat {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid currentColor;
  }

  .proj-status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--soft);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .status-active { background: #10b981; }
  .status-shipped { background: #3b82f6; }
  .status-exp { background: #f59e0b; }

  .proj-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.45rem;
  }

  .proj-title a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .proj-title a:hover {
    color: var(--accent);
  }

  .proj-desc {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proj-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .proj-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .proj-links {
    display: flex;
    gap: 0.6rem;
  }

  .proj-action {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .proj-action:hover {
    color: var(--ink);
  }
  .accent-link {
    color: var(--accent);
  }

  .proj-detail {
    color: var(--ink);
    font-weight: 500;
  }

  /* Gallery Strip */
  .gallery-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .strip-item {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
    display: block;
  }

  .strip-item:hover {
    border-color: var(--ink);
