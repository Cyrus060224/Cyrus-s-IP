---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, getCategoryMeta } from '../../utils/categories';

const allPosts = await getCollection('posts');
// Sort by date descending
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Calculate category counts
const categoryCounts: Record<string, number> = {
  all: posts.length,
};

Object.keys(CATEGORIES).forEach(cat => {
  categoryCounts[cat] = posts.filter(p => p.data.category === cat).length;
});

// Calculate unique tags with counts
const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  post.data.tags?.forEach((tag: string) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Layout 
  title="文章与思考 · Cyrus"
  description="涵盖系统底层、AI 智能体工程、造物日记、旅行见闻与生活散文的完整文章档案。"
>
  <div class="container archive-container">
    <header class="archive-header">
      <div class="archive-header-row">
        <div>
          <div class="mono-eyebrow">ARCHIVE &amp; THOUGHTS · ALL WRITINGS</div>
          <h1 class="serif-title archive-title">文章与思考</h1>
        </div>
        <!-- Owner-only in-place creation trigger -->
        <button id="btn-open-create-post" class="btn btn-primary owner-only in-place-btn">
          <span>✍️</span> 撰写新文章
        </button>
      </div>
      <p class="archive-desc">
        这里记录了我所有的探索与心境。从硬核的 AI 架构与底层技术，到远方的山川旷野与散文杂感。
      </p>
    </header>

    <!-- Category Filter Tabs -->
    <section class="filter-section">
      <div class="category-tabs" role="tablist">
        <button class="cat-tab active" data-category="all">
          全部 <span class="tab-count">{categoryCounts.all}</span>
        </button>
        {Object.values(CATEGORIES).map(cat => (
          <button class="cat-tab" data-category={cat.id}>
            {cat.name} <span class="tab-count">{categoryCounts[cat.id] || 0}</span>
          </button>
        ))}
      </div>

      <!-- Tag Cloud -->
      {sortedTags.length > 0 && (
        <div class="tag-cloud-wrapper">
          <span class="tag-cloud-label">标签库：</span>
          <div class="tag-cloud">
            {sortedTags.map(([tag, count]) => (
              <button class="tag-filter-btn" data-tag={tag}>
                #{tag} <span class="tag-count">({count})</span>
              </button>
            ))}
            <button id="reset-filter-btn" class="reset-btn" style="display: none;">
              ✕ 清除筛选
            </button>
          </div>
        </div>
      )}
    </section>

    <!-- Posts List -->
    <section class="posts-list-section">
      <div id="posts-list" class="posts-list">
        {posts.map(post => {
          const cat = getCategoryMeta(post.data.category);
          const formattedDate = new Intl.DateTimeFormat('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(post.data.pubDate);

          return (
            <article 
              class="post-card" 
              data-category={post.data.category}
              data-tags={JSON.stringify(post.data.tags || [])}
            >
              <div class="card-meta">
                <span class="card-cat" style={`background: ${cat.badgeBg}; color: ${cat.badgeColor}`}>
                  {cat.name}
                </span>
                <time class="card-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              </div>

              <h2 class="card-title">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h2>

              <p class="card-desc">{post.data.description}</p>

              <div class="card-footer">
                <div class="card-tags">
                  {post.data.tags?.map((t: string) => (
                    <span class="card-tag">#{t}</span>
                  ))}
                </div>
                <a href={`/posts/${post.id}`} class="read-link">阅读全文 →</a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="empty-state" style="display: none;">
        <h3 class="empty-title">未找到相关文章</h3>
        <p class="empty-desc">尝试选择其他分类或清除选中的标签。</p>
      </div>
    </section>
  </div>

  <!-- ============================================================== -->
  <!-- In-Place Post Creation Modal / Drawer (Only accessible to Owner) -->
  <!-- ============================================================== -->
  <div id="create-post-modal" class="in-place-modal" style="display: none;">
    <div class="modal-backdrop"></div>
    <div class="modal-dialog">
      <div class="modal-header">
        <div>
          <span class="mono-eyebrow">IN-PLACE PUBLISHER · 实时发布</span>
          <h2 class="modal-title">✍️ 撰写新文章</h2>
        </div>
        <button id="btn-close-post-modal" class="modal-close">&times;</button>
      </div>

      <form id="form-create-post" class="modal-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="inp-post-title">文章标题 <span class="req">*</span></label>
            <input type="text" id="inp-post-title" class="form-input" placeholder="例如：大模型自主智能体的操作系统化思考" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-post-slug">访问标识 (Slug) <span class="req">*</span></label>
            <input type="text" id="inp-post-slug" class="form-input mono-font" placeholder="ai-agent-operating-loop" required />
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="inp-post-cat">专栏分类 <span class="req">*</span></label>
            <select id="inp-post-cat" class="form-select">
              <option value="tech">技术深潜 (tech)</option>
              <option value="essay">散文随笔 (essay)</option>
              <option value="travel">旷野游记 (travel)</option>
              <option value="project">项目复盘 (project)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-post-tags">标签 Tags</label>
            <input type="text" id="inp-post-tags" class="form-input" placeholder="例如：AI, 架构, 思考 (逗号分隔)" />
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-post-featured">置顶推荐</label>
            <label class="checkbox-wrap">
              <input type="checkbox" id="inp-post-featured" />
              <span>设为首页置顶推荐</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="inp-post-hero">封面配图 URL (可选)</label>
          <div class="input-with-btn">
            <input type="text" id="inp-post-hero" class="form-input" placeholder="https://images.unsplash.com/... 或本地选择" />
            <label class="file-pick-btn">
              <span>📷 本地上传</span>
              <input type="file" id="inp-post-hero-file" accept="image/*" class="hidden-file" />
            </label>
          </div>
          <span class="field-hint" id="post-hero-status">支持输入外链或选择本地图片上传</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="inp-post-desc">摘要导语 (Description) <span class="req">*</span></label>
          <textarea id="inp-post-desc" class="form-textarea" rows="2" placeholder="1-2 句话概括文章核心思考..." required></textarea>
        </div>

        <!-- Markdown Editor & Preview -->
        <div class="editor-header-bar">
          <label class="form-label">正文内容 (Markdown) <span class="req">*</span></label>
          <div class="view-switch-btns">
            <button type="button" class="view-switch-btn active" data-view="split">分栏预览</button>
            <button type="button" class="view-switch-btn" data-view="edit">仅编辑</button>
            <button type="button" class="view-switch-btn" data-view="preview">仅预览</button>
          </div>
        </div>

        <div class="editor-wrap split" id="post-editor-wrap">
          <div class="editor-col edit-col">
            <textarea id="inp-post-content" class="editor-textarea" placeholder="## 思考起因

在这里输入 Markdown 正文内容...

- 支持标准 Markdown
- 支持代码高亮与公式
- 支持插入本地或网络图片"></textarea>
          </div>
          <div class="editor-col preview-col">
            <div id="inp-post-preview" class="markdown-preview"></div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="btn-cancel-post-modal" class="btn btn-secondary">取消</button>
          <button type="submit" id="btn-submit-post" class="btn btn-primary">
            <span class="btn-text">立即发布并提交</span>
            <span class="btn-spinner" style="display: none;"></span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Progress Overlay -->
  <div id="post-progress-overlay" class="progress-backdrop" style="display: none;">
    <div class="progress-dialog">
      <div class="progress-spinner"></div>
      <h3 id="post-progress-title" class="progress-title">正在处理发布...</h3>
      <p id="post-progress-desc" class="progress-desc">请勿关闭页面，正在与 GitHub 仓库同步</p>
      <div id="post-progress-done" style="display: none; margin-top: 1.5rem; gap: 0.75rem; justify-content: center;">
        <a id="post-view-commit-btn" href="#" target="_blank" rel="noreferrer" class="btn btn-secondary btn-sm">查看 Commit ↗</a>
        <button id="post-refresh-btn" class="btn btn-primary btn-sm">完成并刷新页面</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { marked } from 'marked';
  import { 
    getOwnerState, 
    commitFileToGitHub, 
    utf8ToBase64, 
    fileToBase64, 
    slugify 
  } from '../../utils/github';

  marked.setOptions({
    breaks: true,
    gfm: true
  });

  // 1. Filtering logic
  function initFilters() {
    const catButtons = document.querySelectorAll('.cat-tab');
    const tagButtons = document.querySelectorAll('.tag-filter-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const postCards = document.querySelectorAll('.post-card');
    const emptyState = document.getElementById('empty-state');

    const urlParams = new URLSearchParams(window.location.search);
    let currentCategory = urlParams.get('category') || 'all';
    let currentTag = urlParams.get('tag') || null;

    function applyFilter() {
      let visibleCount = 0;

      postCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        const cardTagsRaw = card.getAttribute('data-tags');
        const cardTags: string[] = cardTagsRaw ? JSON.parse(cardTagsRaw) : [];

        const categoryMatches = (currentCategory === 'all') || (cardCategory === currentCategory);
        const tagMatches = (!currentTag) || cardTags.includes(currentTag);

        if (categoryMatches && tagMatches) {
          (card as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      catButtons.forEach(btn => {
        const btnCat = btn.getAttribute('data-category');
        btn.classList.toggle('active', btnCat === currentCategory);
      });

      tagButtons.forEach(btn => {
        const btnTag = btn.getAttribute('data-tag');
        btn.classList.toggle('active', btnTag === currentTag);
      });

      if (resetBtn) {
        resetBtn.style.display = (currentCategory !== 'all' || currentTag !== null) ? 'inline-block' : 'none';
      }

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      const params = new URLSearchParams();
      if (currentCategory !== 'all') params.set('category', currentCategory);
      if (currentTag) params.set('tag', currentTag);
      const newUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newUrl);
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilter();
      });
    });

    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        currentTag = (currentTag === tag) ? null : tag;
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      currentCategory = 'all';
      currentTag = null;
      applyFilter();
    });

    applyFilter();
  }

  // 2. In-Place Post Creation Modal
  function initInPlaceCreator() {
    const openBtn = document.getElementById('btn-open-create-post');
    const modal = document.getElementById('create-post-modal');
    const closeBtn = document.getElementById('btn-close-post-modal');
    const cancelBtn = document.getElementById('btn-cancel-post-modal');
    const form = document.getElementById('form-create-post') as HTMLFormElement;

    const titleInput = document.getElementById('inp-post-title') as HTMLInputElement;
    const slugInput = document.getElementById('inp-post-slug') as HTMLInputElement;
    const contentInput = document.getElementById('inp-post-content') as HTMLTextAreaElement;
    const previewEl = document.getElementById('inp-post-preview');
    const heroFileInput = document.getElementById('inp-post-hero-file') as HTMLInputElement;
    const heroTextInput = document.getElementById('inp-post-hero') as HTMLInputElement;
    const heroStatus = document.getElementById('post-hero-status');
    const editorWrap = document.getElementById('post-editor-wrap');
    const viewSwitchBtns = document.querySelectorAll('.view-switch-btn');

    const progressOverlay = document.getElementById('post-progress-overlay');
    const progressTitle = document.getElementById('post-progress-title');
    const progressDesc = document.getElementById('post-progress-desc');
    const progressDone = document.getElementById('post-progress-done');
    const viewCommitBtn = document.getElementById('post-view-commit-btn') as HTMLAnchorElement;
    const refreshBtn = document.getElementById('post-refresh-btn');

    function openModal() {
      if (modal) modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Auto slug from title
    titleInput?.addEventListener('blur', () => {
      if (!slugInput.value.trim() && titleInput.value.trim()) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    // Live preview
    function updatePreview() {
      if (!previewEl || !contentInput) return;
      const raw = contentInput.value;
      previewEl.innerHTML = marked.parse(raw || '*Markdown 正文内容将在此处实时排版预览...*') as string;
    }

    contentInput?.addEventListener('input', updatePreview);
    updatePreview();

    // View switcher
    viewSwitchBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        viewSwitchBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (editorWrap) {
          editorWrap.className = `editor-wrap ${view}`;
        }
      });
    });

    // Hero image file selection
    heroFileInput?.addEventListener('change', () => {
      const file = heroFileInput.files?.[0];
      if (file) {
        if (heroStatus) heroStatus.textContent = `已选择本地图片：${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        heroTextInput.value = `[待上传] /images/posts/${file.name}`;
      }
    });

    // Form submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const { isOwner, token } = getOwnerState();
      if (!isOwner || !token) {
        alert('未检测到站长授权信息，请先访问 /admin 进行认证。');
        window.location.href = '/admin';
        return;
      }

      const title = titleInput.value.trim();
      const slug = slugInput.value.trim().toLowerCase();
      const category = (document.getElementById('inp-post-cat') as HTMLSelectElement).value;
      const tagsRaw = (document.getElementById('inp-post-tags') as HTMLInputElement).value;
      const featured = (document.getElementById('inp-post-featured') as HTMLInputElement).checked;
      const desc = (document.getElementById('inp-post-desc') as HTMLTextAreaElement).value.trim();
      const content = contentInput.value;
      let heroUrl = heroTextInput.value.trim();

      const tags = tagsRaw ? tagsRaw.split(/[,，]/).map(t => t.trim()).filter(Boolean) : [];

      // Open progress dialog
      if (progressOverlay && progressTitle && progressDesc && progressDone) {
        progressTitle.textContent = '正在发布文章...';
        progressDesc.textContent = '正在与 GitHub 建立连接';
        progressDone.style.display = 'none';
        progressOverlay.style.display = 'flex';
      }

      try {
        // Step 1: Upload hero image if file selected
        if (heroFileInput.files?.[0]) {
          if (progressDesc) progressDesc.textContent = '正在上传封面图片至 public/images/posts/...';
          const file = heroFileInput.files[0];
          const ext = file.name.split('.').pop() || 'jpg';
          const imagePath = `public/images/posts/${slug}-${Date.now()}.${ext}`;
          const base64 = await fileToBase64(file);

          await commitFileToGitHub(
            imagePath,
            base64,
            `Upload hero image for post: ${title}`,
            token
          );
          heroUrl = `/${imagePath.replace(/^public\//, '')}`;
        }

        // Step 2: Assemble Markdown file
        if (progressDesc) progressDesc.textContent = '正在生成并提交文章 Markdown...';
        const nowIso = new Date().toISOString().split('T')[0];
        let md = `---\n`;
        md += `title: ${JSON.stringify(title)}\n`;
        md += `description: ${JSON.stringify(desc)}\n`;
        md += `pubDate: ${nowIso}\n`;
        md += `category: "${category}"\n`;
        md += `tags: [${tags.map(t => JSON.stringify(t)).join(', ')}]\n`;
        if (heroUrl && !heroUrl.startsWith('[待上传]')) {
          md += `heroImage: ${JSON.stringify(heroUrl)}\n`;
        }
        md += `featured: ${featured}\n`;
        md += `---\n\n`;
        md += content;

        const postPath = `src/content/posts/${slug}.md`;
        const commitRes = await commitFileToGitHub(
          postPath,
          utf8ToBase64(md),
          `Publish post: ${title} via In-Place Studio`,
          token
        );

        if (progressTitle && progressDesc && progressDone && viewCommitBtn) {
          progressTitle.textContent = '🎉 文章发布成功！';
          progressDesc.textContent = '内容已成功推送至 GitHub 仓库。Cloudflare Pages 正在后台进行自动化增量构建，片刻后全球生效。';
          viewCommitBtn.href = commitRes?.commit?.html_url || 'https://github.com/Cyrus060224/Cyrus-s-IP/commits/main';
          progressDone.style.display = 'flex';
        }

        closeModal();
        form.reset();
      } catch (err: any) {
        if (progressOverlay) progressOverlay.style.display = 'none';
        alert(`发布失败：${err.message}`);
      }
    });

    refreshBtn?.addEventListener('click', () => {
      window.location.reload();
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initFilters();
    initInPlaceCreator();
  });
</script>

<style>
  .archive-container {
    max-width: 820px;
    padding-top: 1rem;
  }

  .archive-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .archive-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .in-place-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 0.8rem;
  }

  .archive-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 2.75rem);
    margin: 0.8rem 0 0.75rem;
    color: var(--ink);
  }

  .archive-desc {
    max-width: 62ch;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* Filter Section */
  .filter-section {
    margin-bottom: 3rem;
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
  }

  .cat-tab {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-tab:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .cat-tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .tab-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  /* Tag Cloud */
  .tag-cloud-wrapper {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .tag-cloud-label {
    font-family: var(--font-mono);
    color: var(--soft);
    font-size: 0.75rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-filter-btn {
    background: none;
    border: 1px solid var(--rule);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tag-filter-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .tag-filter-btn.active {
    background: var(--accent-tint);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .tag-count {
    opacity: 0.65;
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 2px 6px;
  }

  /* Post Cards List */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.75rem;
    transition: all 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .card-cat {
    font-family: var(--font-mono);
