---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, getCategoryMeta } from '../../utils/categories';

const allPosts = await getCollection('posts');
// Sort by date descending
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Calculate category counts
const categoryCounts: Record<string, number> = {
  all: posts.length,
};

Object.keys(CATEGORIES).forEach(cat => {
  categoryCounts[cat] = posts.filter(p => p.data.category === cat).length;
});

// Calculate unique tags with counts
const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  post.data.tags?.forEach((tag: string) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Layout 
  title="文章与思考 · Cyrus"
  description="涵盖系统底层、AI 智能体工程、造物日记、旅行见闻与生活散文的完整文章档案。"
>
  <div class="container archive-container">
    <header class="archive-header">
      <div class="mono-eyebrow">ARCHIVE &amp; THOUGHTS · ALL WRITINGS</div>
      <h1 class="serif-title archive-title">文章与思考</h1>
      <p class="archive-desc">
        这里记录了我所有的探索与心境。从硬核的 AI 架构与底层技术，到远方的山川旷野与散文杂感。
      </p>
    </header>

    <!-- Category Filter Tabs -->
    <section class="filter-section">
      <div class="category-tabs" role="tablist">
        <button class="cat-tab active" data-category="all">
          全部 <span class="tab-count">{categoryCounts.all}</span>
        </button>
        {Object.values(CATEGORIES).map(cat => (
          <button class="cat-tab" data-category={cat.id}>
            {cat.name} <span class="tab-count">{categoryCounts[cat.id] || 0}</span>
          </button>
        ))}
      </div>

      <!-- Tag Cloud -->
      {sortedTags.length > 0 && (
        <div class="tag-cloud-wrapper">
          <span class="tag-cloud-label">标签标签库：</span>
          <div class="tag-cloud">
            {sortedTags.map(([tag, count]) => (
              <button class="tag-filter-btn" data-tag={tag}>
                #{tag} <span class="tag-count">({count})</span>
              </button>
            ))}
            <button id="reset-filter-btn" class="reset-btn" style="display: none;">
              ✕ 清除筛选
            </button>
          </div>
        </div>
      )}
    </section>

    <!-- Posts List -->
    <section class="posts-list-section">
      <div id="posts-list" class="posts-list">
        {posts.map(post => {
          const cat = getCategoryMeta(post.data.category);
          const formattedDate = new Intl.DateTimeFormat('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(post.data.pubDate);

          return (
            <article 
              class="post-card" 
              data-category={post.data.category}
              data-tags={JSON.stringify(post.data.tags || [])}
            >
              <div class="card-meta">
                <span class="card-cat" style={`background: ${cat.badgeBg}; color: ${cat.badgeColor}`}>
                  {cat.name}
                </span>
                <time class="card-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              </div>

              <h2 class="card-title">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h2>

              <p class="card-desc">{post.data.description}</p>

              <div class="card-footer">
                <div class="card-tags">
                  {post.data.tags?.map((t: string) => (
                    <span class="card-tag">#{t}</span>
                  ))}
                </div>
                <a href={`/posts/${post.id}`} class="read-link">
                  阅读全文 →
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="empty-state" style="display: none;">
        <p class="empty-title">该分类或标签下暂无文章</p>
        <p class="empty-desc">更多内容正在路上，请尝试点击其他分类浏览。</p>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  // Client-side interactive category and tag filtering
  function initFilters() {
    const catButtons = document.querySelectorAll('.cat-tab');
    const tagButtons = document.querySelectorAll('.tag-filter-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const postCards = document.querySelectorAll('.post-card');
    const emptyState = document.getElementById('empty-state');

    let currentCategory = 'all';
    let currentTag = null;

    // Read URL query params on load
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('category')) {
      currentCategory = urlParams.get('category');
    }
    if (urlParams.get('tag')) {
      currentTag = urlParams.get('tag');
    }

    function applyFilter() {
      let visibleCount = 0;

      // Update category tab UI
      catButtons.forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-category') === currentCategory);
      });

      // Update tag buttons UI
      tagButtons.forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-tag') === currentTag);
      });

      if (resetBtn) {
        resetBtn.style.display = (currentCategory !== 'all' || currentTag !== null) ? 'inline-flex' : 'none';
      }

      // Filter post cards
      postCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');

        const matchCat = (currentCategory === 'all' || cardCat === currentCategory);
        const matchTag = (!currentTag || cardTags.includes(currentTag));

        if (matchCat && matchTag) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show/hide empty state
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Update URL query string silently
      const params = new URLSearchParams();
      if (currentCategory !== 'all') params.set('category', currentCategory);
      if (currentTag) params.set('tag', currentTag);
      const newUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newUrl);
    }

    // Category click handlers
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilter();
      });
    });

    // Tag click handlers
    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        currentTag = (currentTag === tag) ? null : tag; // Toggle on/off
        applyFilter();
      });
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      currentCategory = 'all';
      currentTag = null;
      applyFilter();
    });

    // Run initial filter
    applyFilter();
  }

  document.addEventListener('DOMContentLoaded', initFilters);
</script>

<style>
  .archive-container {
    max-width: 820px;
    padding-top: 1rem;
  }

  .archive-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .archive-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 2.75rem);
    margin: 0.8rem 0 0.75rem;
    color: var(--ink);
  }

  .archive-desc {
    max-width: 62ch;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* Filter Section */
  .filter-section {
    margin-bottom: 3rem;
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
  }

  .cat-tab {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-tab:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .cat-tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .tab-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  /* Tag Cloud */
  .tag-cloud-wrapper {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .tag-cloud-label {
    font-family: var(--font-mono);
    color: var(--soft);
    font-size: 0.75rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-filter-btn {
    background: none;
    border: 1px solid var(--rule);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tag-filter-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .tag-filter-btn.active {
    background: var(--accent-tint);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .tag-count {
    opacity: 0.65;
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 2px 6px;
  }

  /* Post Cards List */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.75rem;
    transition: all 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .card-cat {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--soft);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  .card-title a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    color: var(--soft);
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.72rem;
  }

  .read-link {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--card-bg);
    border: 1px dashed var(--rule);
    border-radius: 8px;
  }

  .empty-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
