---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
// Sort: featured first, then by date descending
const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
  const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
  return dateB - dateA;
});

const categoryMap: Record<string, { label: string; color: string }> = {
  ai: { label: 'AI & 智能体', color: '#2e5aa8' },
  web: { label: 'Web & 站点', color: '#eb6c36' },
  tool: { label: '实战工具', color: '#2a9d8f' },
  system: { label: '系统底层', color: '#805ad5' },
};

const statusMap: Record<string, { label: string; dotClass: string }> = {
  active: { label: '活跃维护', dotClass: 'status-active' },
  shipped: { label: '已发布', dotClass: 'status-shipped' },
  experiment: { label: '探索实验', dotClass: 'status-exp' },
};
---

<Layout 
  title="造物工坊 · 项目展示 · Cyrus"
  description="Cyrus 的开源项目、AI 智能体工具、可视化实验与技术作品展。"
>
  <div class="container projects-container">
    <header class="projects-header">
      <div class="mono-eyebrow">SHOWCASE &amp; CRAFTS · 造物工坊</div>
      <h1 class="serif-title projects-title">我的项目与实验</h1>
      <p class="projects-desc">
        “What I cannot create, I do not understand.” 记录我从想法雏形、技术选型到完整落地的每一个作品。
      </p>
    </header>

    <!-- Filter Tabs -->
    <div class="projects-tabs">
      <button class="proj-tab active" data-filter="all">全部 ({projects.length})</button>
      <button class="proj-tab" data-filter="ai">AI &amp; 智能体</button>
      <button class="proj-tab" data-filter="web">Web &amp; 站点</button>
      <button class="proj-tab" data-filter="tool">实战工具</button>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid">
      {projects.map(proj => {
        const cat = categoryMap[proj.data.category] || { label: proj.data.category, color: '#666' };
        const status = statusMap[proj.data.status] || { label: proj.data.status, dotClass: 'status-active' };

        return (
          <article class="project-card" data-category={proj.data.category}>
            <div class="card-header">
              <span class="cat-pill" style={`color: ${cat.color}; border-color: ${cat.color}33;`}>
                {cat.label}
              </span>
              <div class="status-indicator">
                <span class={`status-dot ${status.dotClass}`}></span>
                <span class="status-text">{status.label}</span>
              </div>
            </div>

            <h2 class="card-title">
              <a href={`/projects/${proj.id}`}>{proj.data.title}</a>
            </h2>

            <p class="card-desc">{proj.data.description}</p>

            <div class="card-tags">
              {proj.data.tags.map(t => (
                <span class="proj-tag">#{t}</span>
              ))}
            </div>

            <div class="card-actions">
              <div class="external-links">
                {proj.data.github && (
                  <a href={proj.data.github} target="_blank" rel="noreferrer" class="action-btn">
                    GitHub ↗
                  </a>
                )}
                {proj.data.demo && (
                  <a href={proj.data.demo} target="_blank" rel="noreferrer" class="action-btn demo-btn">
                    在线访问 ↗
                  </a>
                )}
              </div>
              <a href={`/projects/${proj.id}`} class="details-link">
                查看详情 →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<script is:inline>
  function initProjectFilters() {
    const tabs = document.querySelectorAll('.proj-tab');
    const cards = document.querySelectorAll('.project-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (filter === 'all' || cardCat === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initProjectFilters);
</script>

<style>
  .projects-container {
    max-width: 860px;
    padding-top: 1rem;
  }

  .projects-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .projects-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 2.75rem);
    margin: 0.8rem 0 0.75rem;
    color: var(--ink);
  }

  .projects-desc {
    max-width: 62ch;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* Filter Tabs */
  .projects-tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .proj-tab {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .proj-tab:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .proj-tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cat-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid currentColor;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--soft);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .status-active { background: #10b981; }
  .status-shipped { background: #3b82f6; }
  .status-exp { background: #f59e0b; }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  .card-title a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .proj-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
  }

  .external-links {
    display: flex;
    gap: 0.6rem;
  }

  .action-btn {
    font-family: var(--font-mono);
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .action-btn:hover {
    color: var(--ink);
  }

  .demo-btn {
    color: var(--accent);
  }

  .details-link {
    font-family: var(--font-mono);
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
