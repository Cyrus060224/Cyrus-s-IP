---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
// Sort: featured first, then by date descending
const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
  const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
  return dateB - dateA;
});

const categoryMap: Record<string, { label: string; color: string }> = {
  ai: { label: 'AI & 智能体', color: '#2e5aa8' },
  web: { label: 'Web & 站点', color: '#eb6c36' },
  tool: { label: '实战工具', color: '#2a9d8f' },
  system: { label: '系统底层', color: '#805ad5' },
};

const statusMap: Record<string, { label: string; dotClass: string }> = {
  active: { label: '活跃维护', dotClass: 'status-active' },
  shipped: { label: '已发布', dotClass: 'status-shipped' },
  experiment: { label: '探索实验', dotClass: 'status-exp' },
};
---

<Layout 
  title="造物工坊 · 项目展示 · Cyrus"
  description="Cyrus 的开源项目、AI 智能体工具、可视化实验与技术作品展。"
>
  <div class="container projects-container">
    <header class="projects-header">
      <div class="projects-header-row">
        <div>
          <div class="mono-eyebrow">SHOWCASE &amp; CRAFTS · 造物工坊</div>
          <h1 class="serif-title projects-title">我的项目与实验</h1>
        </div>
        <!-- Owner-only trigger -->
        <button id="btn-open-create-proj" class="btn btn-primary owner-only in-place-btn">
          <span>🚀</span> 登记新造物
        </button>
      </div>
      <p class="projects-desc">
        “What I cannot create, I do not understand.” 记录我从想法雏形、技术选型到完整落地的每一个作品。
      </p>
    </header>

    <!-- Filter Tabs -->
    <div class="projects-tabs">
      <button class="proj-tab active" data-filter="all">全部 ({projects.length})</button>
      <button class="proj-tab" data-filter="ai">AI &amp; 智能体</button>
      <button class="proj-tab" data-filter="web">Web &amp; 站点</button>
      <button class="proj-tab" data-filter="tool">实战工具</button>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid">
      {projects.map(proj => {
        const cat = categoryMap[proj.data.category] || { label: proj.data.category, color: '#666' };
        const status = statusMap[proj.data.status] || { label: proj.data.status, dotClass: 'status-active' };

        return (
          <article class="project-card" data-category={proj.data.category}>
            <div class="card-header">
              <span class="cat-pill" style={`color: ${cat.color}; border-color: ${cat.color}33;`}>
                {cat.label}
              </span>
              <div class="status-indicator">
                <span class={`status-dot ${status.dotClass}`}></span>
                <span class="status-text">{status.label}</span>
              </div>
            </div>

            <h2 class="card-title">
              <a href={`/projects/${proj.id}`}>{proj.data.title}</a>
            </h2>

            <p class="card-desc">{proj.data.description}</p>

            <div class="card-tags">
              {proj.data.tags.map(t => (
                <span class="proj-tag">#{t}</span>
              ))}
            </div>

            <div class="card-actions">
              <div class="external-links">
                {proj.data.github && (
                  <a href={proj.data.github} target="_blank" rel="noreferrer" class="action-btn">
                    GitHub ↗
                  </a>
                )}
                {proj.data.demo && (
                  <a href={proj.data.demo} target="_blank" rel="noreferrer" class="action-btn demo-btn">
                    在线访问 ↗
                  </a>
                )}
              </div>
              <a href={`/projects/${proj.id}`} class="details-link">
                查看详情 →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- In-Place Project Registration Modal (Only accessible to Owner) -->
  <!-- ============================================================== -->
  <div id="create-proj-modal" class="in-place-modal" style="display: none;">
    <div class="modal-backdrop"></div>
    <div class="modal-dialog">
      <div class="modal-header">
        <div>
          <span class="mono-eyebrow">IN-PLACE REGISTRATION · 登记造物</span>
          <h2 class="modal-title">🚀 登记新造物 / 项目</h2>
        </div>
        <button id="btn-close-proj-modal" class="modal-close">&times;</button>
      </div>

      <form id="form-create-proj" class="modal-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="inp-proj-title">项目名称 <span class="req">*</span></label>
            <input type="text" id="inp-proj-title" class="form-input" placeholder="例如：SuperSearch 极速全文检索系统" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-proj-slug">项目标识 (Slug) <span class="req">*</span></label>
            <input type="text" id="inp-proj-slug" class="form-input mono-font" placeholder="supersearch" required />
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="inp-proj-cat">项目类别 <span class="req">*</span></label>
            <select id="inp-proj-cat" class="form-select">
              <option value="ai">AI &amp; 智能体 (ai)</option>
              <option value="tool">实战工具 (tool)</option>
              <option value="system">系统底层 (system)</option>
              <option value="web">Web &amp; 站点 (web)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-proj-status">当前状态 <span class="req">*</span></label>
            <select id="inp-proj-status" class="form-select">
              <option value="active">活跃维护 (active)</option>
              <option value="shipped">已发布 (shipped)</option>
              <option value="experiment">探索实验 (experiment)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-proj-featured">置顶推荐</label>
            <label class="checkbox-wrap">
              <input type="checkbox" id="inp-proj-featured" />
              <span>设为首屏精选造物</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="inp-proj-desc">项目简介 (Description) <span class="req">*</span></label>
          <textarea id="inp-proj-desc" class="form-textarea" rows="2" placeholder="用一句话阐明解决的核心痛点或价值..." required></textarea>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="inp-proj-github">GitHub 仓库地址 (可选)</label>
            <input type="url" id="inp-proj-github" class="form-input mono-font" placeholder="https://github.com/Cyrus060224/..." />
          </div>

          <div class="form-group">
            <label class="form-label" for="inp-proj-demo">在线访问 / Demo 演示链接 (可选)</label>
            <input type="url" id="inp-proj-demo" class="form-input mono-font" placeholder="https://..." />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="inp-proj-tags">技术栈与关键词 Tags</label>
          <input type="text" id="inp-proj-tags" class="form-input" placeholder="例如：TypeScript, Cloudflare, WebGL" />
        </div>

        <div class="form-group">
          <label class="form-label" for="inp-proj-content">项目详情页内容 (Markdown 正文)</label>
          <textarea id="inp-proj-content" class="form-textarea mono-font" rows="5" placeholder="## 项目初衷与架构设计

介绍项目的实现思路、解决的挑战以及未来演进路线..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" id="btn-cancel-proj-modal" class="btn btn-secondary">取消</button>
          <button type="submit" id="btn-submit-proj" class="btn btn-primary">
            <span class="btn-text">立即登记新造物</span>
            <span class="btn-spinner" style="display: none;"></span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Progress Overlay -->
  <div id="proj-progress-overlay" class="progress-backdrop" style="display: none;">
    <div class="progress-dialog">
      <div class="progress-spinner"></div>
      <h3 id="proj-progress-title" class="progress-title">正在登记新造物...</h3>
      <p id="proj-progress-desc" class="progress-desc">请勿关闭页面，正在提交项目数据至 GitHub</p>
      <div id="proj-progress-done" style="display: none; margin-top: 1.5rem; gap: 0.75rem; justify-content: center;">
        <a id="proj-view-commit-btn" href="#" target="_blank" rel="noreferrer" class="btn btn-secondary btn-sm">查看 Commit ↗</a>
        <button id="proj-refresh-btn" class="btn btn-primary btn-sm">完成并刷新页面</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { 
    getOwnerState, 
    commitFileToGitHub, 
    utf8ToBase64, 
    slugify 
  } from '../../utils/github';

  // 1. Filter logic
  function initProjectFilters() {
    const tabs = document.querySelectorAll('.proj-tab');
    const cards = document.querySelectorAll('.project-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (filter === 'all' || cardCat === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  // 2. In-Place Project Registration Modal
  function initInPlaceProject() {
    const openBtn = document.getElementById('btn-open-create-proj');
    const modal = document.getElementById('create-proj-modal');
    const closeBtn = document.getElementById('btn-close-proj-modal');
    const cancelBtn = document.getElementById('btn-cancel-proj-modal');
    const form = document.getElementById('form-create-proj') as HTMLFormElement;

    const titleInput = document.getElementById('inp-proj-title') as HTMLInputElement;
    const slugInput = document.getElementById('inp-proj-slug') as HTMLInputElement;

    const progressOverlay = document.getElementById('proj-progress-overlay');
    const progressTitle = document.getElementById('proj-progress-title');
    const progressDesc = document.getElementById('proj-progress-desc');
    const progressDone = document.getElementById('proj-progress-done');
    const viewCommitBtn = document.getElementById('proj-view-commit-btn') as HTMLAnchorElement;
    const refreshBtn = document.getElementById('proj-refresh-btn');

    function openModal() {
      if (modal) modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Explicitly guarantee owner button visibility
    const { isOwner } = getOwnerState();
    if (isOwner && openBtn) {
      openBtn.style.setProperty('display', 'inline-flex', 'important');
    }

    // Auto-open if query param ?action=new or ?create=true
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('action') === 'new' || urlParams.get('create') === 'true') {
      setTimeout(openModal, 150);
    }

    titleInput?.addEventListener('blur', () => {
      if (!slugInput.value.trim() && titleInput.value.trim()) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const { isOwner, token } = getOwnerState();
      if (!isOwner || !token) {
        alert('未检测到站长授权信息，请先访问 /admin 进行认证。');
        window.location.href = '/admin';
        return;
      }

      const title = titleInput.value.trim();
      const slug = slugInput.value.trim().toLowerCase();
      const category = (document.getElementById('inp-proj-cat') as HTMLSelectElement).value;
      const status = (document.getElementById('inp-proj-status') as HTMLSelectElement).value;
      const featured = (document.getElementById('inp-proj-featured') as HTMLInputElement).checked;
      const desc = (document.getElementById('inp-proj-desc') as HTMLTextAreaElement).value.trim();
      const github = (document.getElementById('inp-proj-github') as HTMLInputElement).value.trim();
      const demo = (document.getElementById('inp-proj-demo') as HTMLInputElement).value.trim();
      const tagsRaw = (document.getElementById('inp-proj-tags') as HTMLInputElement).value;
      const content = (document.getElementById('inp-proj-content') as HTMLTextAreaElement).value.trim();
      const tags = tagsRaw ? tagsRaw.split(/[,，]/).map(t => t.trim()).filter(Boolean) : [];

      if (progressOverlay && progressTitle && progressDesc && progressDone) {
        progressTitle.textContent = '正在登记新造物...';
        progressDesc.textContent = '正在生成 Markdown 文件并同步至 GitHub';
        progressDone.style.display = 'none';
        progressOverlay.style.display = 'flex';
      }

      try {
        const nowIso = new Date().toISOString().split('T')[0];
        let md = `---\n`;
        md += `title: ${JSON.stringify(title)}\n`;
        md += `description: ${JSON.stringify(desc)}\n`;
        md += `category: "${category}"\n`;
        md += `status: "${status}"\n`;
        md += `tags: [${tags.map(t => JSON.stringify(t)).join(', ')}]\n`;
        if (github) md += `github: ${JSON.stringify(github)}\n`;
        if (demo) md += `demo: ${JSON.stringify(demo)}\n`;
        md += `featured: ${featured}\n`;
        md += `pubDate: ${nowIso}\n`;
        md += `---\n\n`;
        md += content || `## ${title}\n\n${desc}`;

        const projPath = `src/content/projects/${slug}.md`;
        const commitRes = await commitFileToGitHub(
          projPath,
          utf8ToBase64(md),
          `Register new project: ${title} via In-Place Studio`,
          token
        );

        if (progressTitle && progressDesc && progressDone && viewCommitBtn) {
          progressTitle.textContent = '🚀 造物登记成功！';
          progressDesc.textContent = '项目元数据已提交至 GitHub 仓库。Cloudflare Pages 正在增量发布，片刻后即可在列表查看！';
          viewCommitBtn.href = commitRes?.commit?.html_url || 'https://github.com/Cyrus060224/Cyrus-s-IP/commits/main';
          progressDone.style.display = 'flex';
        }

        closeModal();
        form.reset();
      } catch (err: any) {
        if (progressOverlay) progressOverlay.style.display = 'none';
        alert(`登记失败：${err.message}`);
      }
    });

    refreshBtn?.addEventListener('click', () => {
      window.location.reload();
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initProjectFilters();
    initInPlaceProject();
  });
</script>

<style>
  .projects-container {
    max-width: 860px;
    padding-top: 1rem;
  }

  .projects-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .projects-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .in-place-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.55rem 1.25rem;
    border-radius: 20px;
    background: var(--accent) !important;
    color: #ffffff !important;
    border: 1px solid var(--accent) !important;
    box-shadow: 0 2px 10px rgba(235, 108, 54, 0.3);
    margin-bottom: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .in-place-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(235, 108, 54, 0.45);
    opacity: 0.95;
  }

  .projects-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 2.75rem);
    margin: 0.8rem 0 0.75rem;
    color: var(--ink);
  }

  .projects-desc {
    max-width: 62ch;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.65;
  }

  /* Filter Tabs */
  .projects-tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .proj-tab {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .proj-tab:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .proj-tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cat-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid currentColor;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--soft);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .status-active { background: #10b981; }
  .status-shipped { background: #3b82f6; }
  .status-exp { background: #f59e0b; }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  .card-title a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .proj-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--soft);
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
  }

  .external-links {
    display: flex;
    gap: 0.6rem;
  }

  .action-btn {
    font-family: var(--font-mono);
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .action-btn:hover {
    color: var(--ink);
  }

  .demo-btn {
    color: var(--accent);
  }

  .details-link {
    font-family: var(--font-mono);
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  /* In-Place Modal */
  .in-place-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 12, 16, 0.75);
    backdrop-filter: blur(6px);
  }

  .modal-dialog {
    position: relative;
    z-index: 10;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 12px;
    max-width: 760px;
    width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    padding: 2rem;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.25);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .modal-title {
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 0.35rem;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.6rem;
    color: var(--muted);
    cursor: pointer;
    line-height: 1;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .form-grid-2, .form-grid-3 { grid-template-columns: 1fr; }
    .modal-dialog { padding: 1.25rem; }
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .req {
    color: var(--accent);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border-radius: 6px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    transition: border-color 0.15s ease;
  }

  .mono-font {
    font-family: var(--font-mono);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--card-bg);
  }

  .checkbox-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 38px;
