    const token = localStorage.getItem(STORAGE_KEY);
    if (!token) {
      if (tokenDot) tokenDot.className = 'status-dot-sm status-disconnected';
      if (tokenStatusText) tokenStatusText.textContent = '未连接 Token';
      return;
    }

    if (tokenDot) tokenDot.className = 'status-dot-sm status-checking';
    if (tokenStatusText) tokenStatusText.textContent = '验证中...';

    const result = await verifyToken(token);
    if (result.valid) {
      if (tokenDot) tokenDot.className = 'status-dot-sm status-connected';
      if (tokenStatusText) tokenStatusText.textContent = '已连接仓库';
    } else {
      if (tokenDot) tokenDot.className = 'status-dot-sm status-disconnected';
      if (tokenStatusText) tokenStatusText.textContent = 'Token 已失效';
    }
  }

