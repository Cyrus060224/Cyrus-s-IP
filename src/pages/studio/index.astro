---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="创作工坊 · Creator Studio · Cyrus"
  description="无需服务器，直接在浏览器中发表文章、上传图片与视频，一键推送至个人网站并全球自动发布。"
>
  <div class="container studio-container">
    <!-- Studio Header -->
    <header class="studio-header">
      <div class="header-left">
        <div class="mono-eyebrow">CREATOR STUDIO · 独立主权创作中心</div>
        <h1 class="serif-title studio-title">创作工坊</h1>
        <p class="studio-desc">
          在任何设备上撰写长文、分享随笔、上传胶片摄影或发布视频动效。内容将直接提交至 GitHub 并由 Cloudflare 自动全球发布。
        </p>
      </div>

      <div class="token-status-card" id="token-status-box">
        <div class="token-status-indicator">
          <span class="status-dot-sm" id="token-dot"></span>
          <span id="token-status-text" class="token-status-label">检查连接中...</span>
        </div>
        <button id="open-token-modal" class="btn-token-config">
          <span>⚙️</span> 配置 Token
        </button>
      </div>
    </header>

    <!-- Studio Navigation Tabs -->
    <div class="studio-tabs">
      <button class="studio-tab active" data-target="tab-post">
        <span class="tab-icon">✍️</span> 撰写文章 / 随笔
      </button>
      <button class="studio-tab" data-target="tab-gallery">
        <span class="tab-icon">📸</span> 上传光影 / 视频
      </button>
      <button class="studio-tab" data-target="tab-project">
        <span class="tab-icon">🚀</span> 登记造物 / 项目
      </button>
      <button class="studio-tab" data-target="tab-guide">
        <span class="tab-icon">📖</span> 部署与运作机制
      </button>
    </div>

    <!-- Alert Banner for Notice / Status -->
    <div id="status-toast" class="status-toast" style="display: none;">
      <div class="toast-content">
        <span id="toast-icon">ℹ️</span>
        <span id="toast-message">提示信息</span>
      </div>
      <button id="toast-close" class="toast-close">&times;</button>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: 撰写文章 (Post) -->
    <!-- ========================================== -->
    <section id="tab-post" class="studio-pane active">
      <form id="form-post" class="studio-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="post-title">文章标题 <span class="required">*</span></label>
            <input type="text" id="post-title" class="form-input" placeholder="例如：大模型自主智能体的操作系统化思考" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="post-slug">访问标识 (Slug) <span class="required">*</span></label>
            <input type="text" id="post-slug" class="form-input mono-font" placeholder="ai-agent-operating-loop" required />
            <span class="field-hint">将作为文章网址路径，仅包含小写字母、数字和连字符</span>
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="post-category">专栏分类 <span class="required">*</span></label>
            <select id="post-category" class="form-select">
              <option value="tech">技术深潜 (tech)</option>
              <option value="essay">散文随笔 (essay)</option>
              <option value="travel">旷野游记 (travel)</option>
              <option value="project">项目复盘 (project)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="post-tags">标签 Tags</label>
            <input type="text" id="post-tags" class="form-input" placeholder="例如：AI, 智能体, 系统架构 (逗号分隔)" />
          </div>

          <div class="form-group">
            <label class="form-label" for="post-featured">置顶推荐</label>
            <label class="toggle-checkbox">
              <input type="checkbox" id="post-featured" />
              <span class="toggle-label">设为首页置顶推荐</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="post-hero">封面配图 URL (可选)</label>
          <div class="input-with-upload">
            <input type="text" id="post-hero" class="form-input" placeholder="https://images.unsplash.com/... 或本地上传" />
            <label class="upload-btn-label">
              <span>📷 上传图片</span>
              <input type="file" id="post-hero-file" accept="image/*" class="file-hidden" />
            </label>
          </div>
          <span class="field-hint" id="post-hero-hint">可输入外部图片链接，或点击按钮从手机/电脑上传</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="post-desc">摘要导语 (Description) <span class="required">*</span></label>
          <textarea id="post-desc" class="form-textarea" rows="2" placeholder="1-2 句话概括文章核心思考，将展示在列表卡片与社交媒体预览中..." required></textarea>
        </div>

        <!-- Markdown Editor & Preview -->
        <div class="editor-header">
          <label class="form-label">正文内容 (Markdown) <span class="required">*</span></label>
          <div class="editor-switch">
            <button type="button" class="switch-btn active" data-view="split">分栏预览</button>
            <button type="button" class="switch-btn" data-view="edit">仅编辑</button>
            <button type="button" class="switch-btn" data-view="preview">仅预览</button>
          </div>
        </div>

        <div class="editor-container split" id="post-editor-box">
          <div class="editor-pane edit-pane">
            <textarea id="post-content" class="editor-textarea" placeholder="## 思考起因

在这里输入 Markdown 正文内容...

- 支持标准 Markdown
- 支持代码高亮与公式
- 支持插入本地或网络图片"></textarea>
          </div>
          <div class="editor-pane preview-pane">
            <div id="post-preview" class="markdown-preview"></div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" id="btn-submit-post" class="btn btn-primary submit-btn">
            <span class="btn-text">立即发布文章</span>
            <span class="btn-spinner" style="display: none;"></span>
          </button>
        </div>
      </form>
    </section>

    <!-- ========================================== -->
    <!-- TAB 2: 上传光影 (Gallery - Photo / Video) -->
    <!-- ========================================== -->
    <section id="tab-gallery" class="studio-pane">
      <form id="form-gallery" class="studio-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="gal-title">光影标题 <span class="required">*</span></label>
            <input type="text" id="gal-title" class="form-input" placeholder="例如：川西高原的暮色星芒" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="gal-slug">文件名标识 (Slug) <span class="required">*</span></label>
            <input type="text" id="gal-slug" class="form-input mono-font" placeholder="sunset-plateau" required />
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="gal-type">作品类型 <span class="required">*</span></label>
            <select id="gal-type" class="form-select">
              <option value="image">摄影相片 (Image)</option>
              <option value="video">视频 / 动效片段 (Video)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="gal-category">所属栏目 <span class="required">*</span></label>
            <select id="gal-category" class="form-select">
              <option value="travel">旅行足迹 (travel)</option>
              <option value="film">胶片日记 (film)</option>
              <option value="video">视频动效 (video)</option>
              <option value="life">生活切片 (life)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="gal-date">拍摄 / 记录时间 <span class="required">*</span></label>
            <input type="date" id="gal-date" class="form-input" required />
          </div>
        </div>

        <!-- Media Upload Zone -->
        <div class="form-group">
          <label class="form-label">媒体源文件 (图片或视频) <span class="required">*</span></label>
          <div class="media-upload-tabs">
            <button type="button" class="media-src-tab active" data-src-type="upload">本地文件上传</button>
            <button type="button" class="media-src-tab" data-src-type="url">外部网络链接</button>
          </div>

          <!-- File Drop Area -->
          <div id="drop-zone" class="drop-zone">
            <input type="file" id="gal-file-input" class="file-hidden" accept="image/*,video/mp4,video/webm,video/quicktime" />
            <div class="drop-content" id="drop-prompt">
              <span class="drop-icon">📁</span>
              <p class="drop-text">拖拽图片或视频到此处，或 <strong>点击选择文件</strong></p>
              <span class="drop-hint">支持 JPG, PNG, WebP, MP4, WebM (单文件推荐小于 50MB)</span>
            </div>
            <!-- Preview of selected file -->
            <div id="drop-preview-box" class="drop-preview-box" style="display: none;">
              <div id="preview-media-wrapper"></div>
              <div class="preview-file-info">
                <span id="preview-filename" class="preview-filename">filename.jpg</span>
                <span id="preview-filesize" class="preview-filesize">0 MB</span>
                <button type="button" id="remove-file-btn" class="btn-remove-file">重新选择</button>
              </div>
            </div>
          </div>

          <!-- Direct URL Area -->
          <div id="url-input-box" class="url-input-box" style="display: none;">
            <input type="url" id="gal-media-url" class="form-input" placeholder="https://example.com/assets/video.mp4" />
            <span class="field-hint">适用于高码率 4K 视频、B站/YouTube/Cloudflare R2 直链或图床链接</span>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="gal-location">拍摄地点 (可选)</label>
            <input type="text" id="gal-location" class="form-input" placeholder="例如：川西 · 稻城亚丁" />
          </div>

          <div class="form-group">
            <label class="form-label" for="gal-camera">设备与拍摄参数 (可选)</label>
            <input type="text" id="gal-camera" class="form-input" placeholder="例如：Fujifilm X-T5 · 23mm f/2.0 · ISO 160" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="gal-desc">作品背后的故事 / 随笔 (可选)</label>
          <textarea id="gal-desc" class="form-textarea" rows="3" placeholder="写下一两句当时的心境、光影变幻或创作背景..."></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="gal-tags">标签 Tags</label>
          <input type="text" id="gal-tags" class="form-input" placeholder="例如：旅行, 雪山, 富士胶片 (逗号分隔)" />
        </div>

        <div class="form-actions">
          <button type="submit" id="btn-submit-gallery" class="btn btn-primary submit-btn">
            <span class="btn-text">立即上传并发布光影</span>
            <span class="btn-spinner" style="display: none;"></span>
          </button>
        </div>
      </form>
    </section>

    <!-- ========================================== -->
    <!-- TAB 3: 登记造物 (Project) -->
    <!-- ========================================== -->
    <section id="tab-project" class="studio-pane">
      <form id="form-project" class="studio-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="proj-title">项目名称 <span class="required">*</span></label>
            <input type="text" id="proj-title" class="form-input" placeholder="例如：AuditCore · 智能代码合规审查引擎" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="proj-slug">项目标识 (Slug) <span class="required">*</span></label>
            <input type="text" id="proj-slug" class="form-input mono-font" placeholder="auditcore" required />
          </div>
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label" for="proj-category">项目类别 <span class="required">*</span></label>
            <select id="proj-category" class="form-select">
              <option value="ai">AI &amp; 智能体 (ai)</option>
              <option value="tool">实战工具 (tool)</option>
              <option value="system">系统底层 (system)</option>
              <option value="web">Web &amp; 站点 (web)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="proj-status">当前状态 <span class="required">*</span></label>
            <select id="proj-status" class="form-select">
              <option value="active">活跃维护 (active)</option>
              <option value="shipped">已发布上线 (shipped)</option>
              <option value="experiment">探索实验 (experiment)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="proj-featured">置顶推荐</label>
            <label class="toggle-checkbox">
              <input type="checkbox" id="proj-featured" />
              <span class="toggle-label">设为造物工坊首屏精选</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="proj-desc">项目简介 (Description) <span class="required">*</span></label>
          <textarea id="proj-desc" class="form-textarea" rows="2" placeholder="用一句话清晰阐述这个造物解决的核心痛点或价值..." required></textarea>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="proj-github">GitHub 仓库地址 (可选)</label>
            <input type="url" id="proj-github" class="form-input mono-font" placeholder="https://github.com/Cyrus060224/..." />
          </div>

          <div class="form-group">
            <label class="form-label" for="proj-demo">在线访问 / Demo 演示链接 (可选)</label>
            <input type="url" id="proj-demo" class="form-input mono-font" placeholder="https://..." />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="proj-tags">技术栈与关键词 Tags</label>
          <input type="text" id="proj-tags" class="form-input" placeholder="例如：Python, AST, LLM, Cloudflare" />
        </div>

        <div class="form-group">
          <label class="form-label" for="proj-content">项目详情页内容 (Markdown 正文)</label>
          <textarea id="proj-content" class="form-textarea mono-font" rows="6" placeholder="## 项目初衷与架构设计

介绍项目的实现思路、解决的挑战以及未来演进路线..."></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" id="btn-submit-project" class="btn btn-primary submit-btn">
            <span class="btn-text">立即登记新造物</span>
            <span class="btn-spinner" style="display: none;"></span>
          </button>
        </div>
      </form>
    </section>

    <!-- ========================================== -->
    <!-- TAB 4: 机制说明与指南 (Guide) -->
    <!-- ========================================== -->
    <section id="tab-guide" class="studio-pane">
      <div class="guide-card">
        <h2 class="guide-title">无服务器 (Serverless) 极简发布架构</h2>
        <p class="guide-lead">
          你不需要为个人网站支付任何云服务器 (ECS / 轻量应用服务器) 费用。我们通过<strong>「浏览器 Studio + GitHub API + Cloudflare Pages」</strong>构建了零成本、高可用、永不当机的现代化技术流：
        </p>

        <div class="guide-steps">
          <div class="guide-step">
            <div class="step-num">01</div>
            <div class="step-content">
              <h3>在 Studio 填写与上传</h3>
              <p>你在本页面直接撰写 Markdown、上传照片或视频。点击发布后，浏览器会通过安全加密的 GitHub API，将媒体文件与 Markdown 文件原子性地 Commit 提交至你的 GitHub 仓库。</p>
            </div>
          </div>

          <div class="guide-step">
            <div class="step-num">02</div>
            <div class="step-content">
              <h3>GitHub 仓库版本化管理</h3>
              <p>所有文章保存在 <code>src/content/posts/</code>，摄影保存在 <code>src/content/gallery/</code>，图片/视频保存在 <code>public/</code>。每一次发布都有完整的 Git 版本快照，永不丢失。</p>
            </div>
          </div>

          <div class="guide-step">
            <div class="step-num">03</div>
            <div class="step-content">
              <h3>Cloudflare Pages 全球秒级构建</h3>
              <p>Cloudflare 监测到仓库 <code>main</code> 分支的新 Commit 后，立即自动触发全球边缘增量构建。约 20~30 秒内，新内容自动生效并分发至全球 300+ 边缘节点。</p>
            </div>
          </div>
        </div>

        <div class="guide-callout">
          <h4>🔒 关于隐私与安全</h4>
          <p>你的 GitHub Personal Access Token (PAT) 仅保存在你的本地浏览器（<code>localStorage</code>）中，绝不会经过或上传到任何第三方中转服务器。只有持有你 Token 的设备才能向仓库发布内容。</p>
        </div>
      </div>
    </section>
  </div>

  <!-- ========================================== -->
  <!-- Token Configuration Modal -->
  <!-- ========================================== -->
  <div id="token-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="modal-title">配置 GitHub 访问令牌 (PAT)</h3>
        <button id="close-token-modal" class="modal-close">&times;</button>
      </div>

      <div class="modal-body">
        <p class="modal-desc">
          为了能够直接从浏览器发布内容并上传媒体，需要提供一个拥有 <strong>Cyrus060224/Cyrus-s-IP</strong> 仓库写入权限的 GitHub Token。
        </p>

        <div class="form-group">
          <label class="form-label" for="pat-input">Personal Access Token (PAT)</label>
          <input 
            type="password" 
            id="pat-input" 
            class="form-input mono-font" 
            placeholder="ghp_... 或 github_pat_..." 
            autocomplete="off"
          />
        </div>

        <div class="modal-instructions">
          <h4>如何获取 Token？(只需 30 秒)</h4>
          <ol>
            <li>打开 GitHub <a href="https://github.com/settings/tokens" target="_blank" rel="noreferrer">Developer Settings → Personal Access Tokens</a></li>
            <li>点击 <strong>Generate new token (classic)</strong></li>
            <li>Note 填写 <code>Cyrus IP Studio</code>，并在权限列表勾选 <strong>repo</strong>（拥有仓库读写权限）</li>
            <li>点击底部绿色按钮 <strong>Generate token</strong> 并复制生成的代码，粘贴回此处即可</li>
          </ol>
        </div>

        <div id="test-connection-result" class="test-result" style="display: none;"></div>
      </div>

      <div class="modal-footer">
        <button type="button" id="btn-test-token" class="btn btn-secondary">测试连接</button>
        <button type="button" id="btn-save-token" class="btn btn-primary">保存配置</button>
      </div>
    </div>
  </div>

  <!-- Publishing Progress Overlay -->
  <div id="publishing-overlay" class="modal-backdrop" style="display: none;">
    <div class="progress-box">
      <div class="progress-spinner"></div>
      <h3 id="progress-status-title" class="progress-title">正在处理发布...</h3>
      <p id="progress-status-desc" class="progress-desc">请勿关闭页面，正在与 GitHub 仓库同步</p>
      <div id="progress-success-actions" style="display: none; margin-top: 1.5rem;">
        <a id="view-commit-link" href="#" target="_blank" rel="noreferrer" class="btn btn-secondary">在 GitHub 查看提交 ↗</a>
        <button id="close-progress-btn" class="btn btn-primary">完成</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { marked } from 'marked';

  // Constants
  const REPO_OWNER = 'Cyrus060224';
  const REPO_NAME = 'Cyrus-s-IP';
  const REPO_BRANCH = 'main';
  const STORAGE_KEY = 'cyrus_github_pat';

  // Setup marked renderer
  marked.setOptions({
    breaks: true,
    gfm: true
  });

  // State
  let currentFile: File | null = null;
  let mediaSourceMode: 'upload' | 'url' = 'upload';

  // DOM Elements
  const tokenModal = document.getElementById('token-modal');
  const openTokenModalBtn = document.getElementById('open-token-modal');
  const closeTokenModalBtn = document.getElementById('close-token-modal');
  const patInput = document.getElementById('pat-input') as HTMLInputElement;
  const btnTestToken = document.getElementById('btn-test-token');
  const btnSaveToken = document.getElementById('btn-save-token');
  const testResultBox = document.getElementById('test-connection-result');
  const tokenDot = document.getElementById('token-dot');
  const tokenStatusText = document.getElementById('token-status-text');

  const publishingOverlay = document.getElementById('publishing-overlay');
  const progressTitle = document.getElementById('progress-status-title');
  const progressDesc = document.getElementById('progress-status-desc');
  const progressSuccessActions = document.getElementById('progress-success-actions');
  const viewCommitLink = document.getElementById('view-commit-link') as HTMLAnchorElement;
  const closeProgressBtn = document.getElementById('close-progress-btn');

  const statusToast = document.getElementById('status-toast');
  const toastMessage = document.getElementById('toast-message');
  const toastIcon = document.getElementById('toast-icon');
  const toastClose = document.getElementById('toast-close');

  // Helper: Show Toast
  function showToast(msg: string, type: 'info' | 'success' | 'error' = 'info') {
    if (!statusToast || !toastMessage || !toastIcon) return;
    toastMessage.textContent = msg;
    toastIcon.textContent = type === 'success' ? '✓' : type === 'error' ? '⚠️' : 'ℹ️';
    statusToast.className = `status-toast ${type}`;
    statusToast.style.display = 'flex';

    if (type !== 'error') {
      setTimeout(() => {
        statusToast.style.display = 'none';
      }, 5000);
    }
  }

  toastClose?.addEventListener('click', () => {
    if (statusToast) statusToast.style.display = 'none';
  });

  // Helper: Utf8 to Base64
  function utf8ToBase64(str: string): string {
    const bytes = new TextEncoder().encode(str);
    let binString = '';
    for (let i = 0; i < bytes.length; i++) {
      binString += String.fromCharCode(bytes[i]);
    }
    return btoa(binString);
  }

  // Helper: File to Base64
  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result as string;
        // Strip data:mime/type;base64,
        const base64 = result.split(',')[1];
        resolve(base64);
      };
      reader.onerror = error => reject(error);
      reader.readAsDataURL(file);
    });
  }

  // Helper: Slugify title
  function slugify(text: string): string {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '') || `post-${Date.now()}`;
  }

  // Helper: Commit file to GitHub REST API
  async function commitFileToGitHub(
    path: string, 
    contentBase64: string, 
    commitMessage: string,
    token: string
  ): Promise<any> {
    const url = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${path}`;
    
    // Check if file exists to obtain SHA if updating
    let sha: string | undefined = undefined;
    try {
      const checkRes = await fetch(url, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/vnd.github.v3+json'
        }
      });
      if (checkRes.ok) {
        const existingData = await checkRes.json();
        sha = existingData.sha;
      }
    } catch (e) {
      // file does not exist, safe to create
    }

    const payload: any = {
      message: commitMessage,
      content: contentBase64,
      branch: REPO_BRANCH
    };
    if (sha) {
      payload.sha = sha;
    }

    const res = await fetch(url, {
      method: 'PUT',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json',
        'Accept': 'application/vnd.github.v3+json'
      },
      body: JSON.stringify(payload)
    });

    if (!res.ok) {
      const errorJson = await res.json().catch(() => ({}));
      throw new Error(errorJson.message || `GitHub API 错误 (${res.status})`);
    }

    return await res.json();
  }

  // Verify Token connection
  async function verifyToken(token: string): Promise<{ valid: boolean; user?: string; error?: string }> {
    try {
      const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/vnd.github.v3+json'
        }
      });
      if (res.ok) {
        const data = await res.json();
        return { valid: true, user: data.permissions?.push ? '已授权写权限' : '仅有读权限' };
      } else {
        const err = await res.json();
        return { valid: false, error: err.message || 'Token 无效或权限不足' };
      }
    } catch (err: any) {
      return { valid: false, error: err.message || '网络请求失败' };
    }
  }

  // Init token status display
