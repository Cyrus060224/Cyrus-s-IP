---
/**
 * ORBITAL SUNRISE · HERO HEADER
 * Clean, direct personal introduction with ambient 3D orbital sunrise background
 */
import '../../styles/observatory-hero.css';

interface Props {
  postsCount: number;
  latestPostDate?: string;
  projectsCount: number;
  latestProjectDate?: string;
  galleryCount: number;
  latestGalleryDate?: string;
}

const {
  postsCount = 0,
  latestPostDate = '2026.10.16',
  projectsCount = 0,
  latestProjectDate = '2026.10.12',
  galleryCount = 0,
  latestGalleryDate = '2026.10.11'
} = Astro.props;
---

<section class="observatory-hero-wrapper" id="observatory-hero">
  <!-- 1. High-fidelity WebP Static Backdrop for Non-JS / No-WebGL Fallback & Instant First Paint -->
  <picture class="observatory-static-backdrop" id="observatory-static-backdrop" aria-hidden="true">
    <source media="(max-width: 767px)" srcset="/images/observatory/orbital_sunrise_mobile.webp" type="image/webp" />
    <img 
      src="/images/observatory/orbital_sunrise_desktop.webp" 
      alt="Orbital Sunrise over Horizon" 
      width="1440" 
      height="720" 
      class="observatory-static-img" 
      loading="eager"
      decoding="async"
    />
  </picture>

  <!-- 2. WebGL 3D Canvas Mounting Point (Ambient Background Only) -->
  <div id="observatory-canvas-mount" class="observatory-canvas-container"></div>

  <!-- 3. Foreground Main Content: Title, Subtitle and 3 Direct Section Cards -->
  <div class="hero-foreground-content">
    <div class="container hero-content-inner">
      <div class="hero-title-block">
        <h1 class="hero-main-title">
          <span class="hero-title-line">我在学 AI，</span>
          <span class="hero-title-line">也在认真生活。</span>
        </h1>
        <p class="hero-sub-desc">这里是 Cyrus 的学习笔记、随笔、项目和照片。</p>
      </div>

      <!-- Three Entry Cards -->
      <nav class="hero-entry-cards" aria-label="核心版块入口">
        <a href="/posts" class="hero-entry-card">
          <div class="card-head">
            <span class="card-title">文章</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </div>
          <p class="card-desc">AI 学习笔记与生活随笔</p>
          <div class="card-meta">共 {postsCount} 篇 · 最近更新 {latestPostDate}</div>
        </a>

        <a href="/projects" class="hero-entry-card">
          <div class="card-head">
            <span class="card-title">项目</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </div>
          <p class="card-desc">我做过的东西和背后的思路</p>
          <div class="card-meta">共 {projectsCount} 个 · 最近上线 {latestProjectDate}</div>
        </a>

        <a href="/gallery" class="hero-entry-card">
          <div class="card-head">
            <span class="card-title">照片</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </div>
          <p class="card-desc">随手拍下的光影</p>
          <div class="card-meta">共 {galleryCount} 组 · 最近更新 {latestGalleryDate}</div>
        </a>
      </nav>
    </div>
  </div>
</section>

<script>
  import { Stage } from './core/Stage';
  import { detectDeviceCapabilities } from './utils/deviceTier';

  let activeStage: Stage | null = null;

  function cleanupObservatory() {
    if (activeStage) {
      activeStage.dispose();
      activeStage = null;
    }
  }

  function initObservatory() {
    const mount = document.getElementById('observatory-canvas-mount');
    if (!mount) return;

    cleanupObservatory();

    const profile = detectDeviceCapabilities();
    if (!profile.hasWebGL) {
      return;
    }

    try {
      activeStage = new Stage({
        container: mount
      });
    } catch (err) {
      console.error('Failed to initialize 3D orbital sunrise:', err);
    }
  }

  // Astro View Transitions lifecycle hooks
  document.addEventListener('astro:page-load', () => {
    initObservatory();
  });

  document.addEventListener('astro:before-swap', cleanupObservatory);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initObservatory();
  }
</script>
